1d:["$","section",null,{"id":"why-us","data-reveal":true,"className":"scroll-mt-24 border-b-hairline-soft py-20","children":[["$","p",null,{"className":"font-mono text-label uppercase text-fg-muted [letter-spacing:var(--tracking-label)]","children":"Why WeEvolveIT"}],["$","h2",null,{"className":"mt-4 max-w-[26ch] font-display text-display-l font-extrabold text-fg [text-wrap:balance]","children":"A nearshore AI automation agency that ships."}],"$undefined",["$","p",null,{"className":"mt-8 font-mono text-body text-fg-secondary","children":"We're an AI-native automation agency built for production, not slideware — AI business automation, from consulting to build. We work nearshore in your time zone — senior engineers, not an offshore handoff 12 hours away. We scope by ROI (AI automation consulting up front), wire automations into your ERP, CRM, and tools, and add AI for the exceptions that break rule-based platforms. And because we run on the factory floor too — nearshore from our Monterrey base in Mexico's manufacturing corridor — industrial and back-office process automation come from one team. 1,000+ projects across 17 countries in 15+ years."}],["$","ul",null,{"data-reveal-stagger":true,"className":"mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4","children":[["$","li","AI, not just rules",{"className":"flex flex-col rounded-xl border-hairline bg-white/[0.015] p-6","children":[false,["$","h3",null,{"className":"font-display text-display-s font-bold text-fg","children":"AI, not just rules"}],["$","p",null,{"className":"mt-2 font-mono text-body-sm text-fg-secondary","children":"Reasoning for the exceptions RPA breaks on."}]]}],["$","li","Nearshore to the US",{"className":"flex flex-col rounded-xl border-hairline bg-white/[0.015] p-6","children":[false,["$","h3",null,{"className":"font-display text-display-s font-bold text-fg","children":"Nearshore to the US"}],["$","p",null,{"className":"mt-2 font-mono text-body-sm text-fg-secondary","children":"Senior engineers in your time zone, not offshore."}]]}],["$","li","ROI-first",{"className":"flex flex-col rounded-xl border-hairline bg-white/[0.015] p-6","children":[false,["$","h3",null,{"className":"font-display text-display-s font-bold text-fg","children":"ROI-first"}],["$","p",null,{"className":"mt-2 font-mono text-body-sm text-fg-secondary","children":"We automate the bottleneck, not the busywork."}]]}],["$","li","Process + industrial",{"className":"flex flex-col rounded-xl border-hairline bg-white/[0.015] p-6","children":[false,["$","h3",null,{"className":"font-display text-display-s font-bold text-fg","children":"Process + industrial"}],["$","p",null,{"className":"mt-2 font-mono text-body-sm text-fg-secondary","children":"Back-office and factory-floor, from one team."}]]}]]}],"$undefined","$undefined"]}]
