n",null,{"aria-hidden":true,"className":"mt-[0.5em] h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","p",null,{"className":"font-mono text-body-sm text-fg-secondary","children":[["$","span",null,{"className":"font-bold text-fg","children":"Cited, then you"}]," — ","The same playbook that gets us cited gets your brand into AI answers."]}]]}]]}]]}],["$","$L39",null,{"steps":[{"img":"01-audit","label":"Audit AI visibility","caption":"We measure where you appear (or don't) in ChatGPT, Perplexity, and AI Overviews today."},{"img":"02-structure","label":"Structure for answers","caption":"We restructure content into clear, extractable answers AI can quote."},{"img":"03-entities","label":"Entities & schema","caption":"Schema and entity signals so the models identify and trust your brand."},{"img":"04-content","label":"AI-citation content","caption":"Content written the way LLMs retrieve and cite their sources."},{"img":"05-measure","label":"Measure citations","caption":"We track your share of AI answers and citations — and keep improving."}],"basePath":"/images/services/generative-engine-optimization/meta-flow"}]]}]}]
