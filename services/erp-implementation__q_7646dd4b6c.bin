16:["$","section",null,{"id":"what-is","data-reveal":true,"className":"scroll-mt-24 border-b-hairline-soft py-20","children":[["$","div",null,{"className":"grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16","children":[["$","div",null,{"children":[["$","h2",null,{"className":"max-w-[20ch] font-display text-display-l font-extrabold text-fg [text-wrap:balance]","children":"What is ERP implementation?"}],["$","p",null,{"className":"mt-8 font-mono text-body text-fg-secondary","children":"ERP implementation is the process of selecting, configuring, and rolling out an enterprise resource planning system — like NetSuite, SAP, Odoo, or Microsoft Dynamics — to run finance, inventory, operations, and reporting on one connected platform, then migrating your data and training your team onto it."}]]}],["$","figure",null,{"className":"relative aspect-[4/3] overflow-hidden rounded-2xl","children":["$","$L31",null,{"src":"/images/services/erp/what-is.webp","alt":"An ERP consultant configuring connected business modules — finance, inventory, operations, and HR — into one unified platform","fill":true,"sizes":"(max-width: 1024px) 100vw, 50vw","className":"object-cover"}]}]]}],["$","dl",null,{"className":"mt-12 grid grid-cols-1 gap-4 md:grid-cols-2","children":[["$","div","ERP implementation vs. ERP migration?",{"className":"rounded-xl border-hairline bg-white/[0.015] p-6","children":[["$","dt",null,{"className":"font-display text-display-s font-bold text-fg","children":"ERP implementation vs. ERP migration?"}],["$","dd",null,{"className":"mt-3 font-mono text-body text-fg-secondary","children":"Implementation is standing up an ERP for the first time (or replacing a non-ERP setup): configure, migrate data, train, go live. Migration is moving from one existing ERP to another. Both share the same phased playbook; migration adds the work of mapping data out of the old system."}]]}],["$","div","On-premise vs. cloud ERP?",{"className":"rounded-xl border-hairline bg-white/[0.015] p-6","children":[["$","dt",null,{"className":"font-display text-display-s font-bold text-fg","children":"On-premise vs. cloud ERP?"}],["$","dd",null,{"className":"mt-3 font-mono text-body text-fg-secondary","children":"On-premise ERP runs on your own servers — more control, more upkeep. Cloud ERP (NetSuite, Dynamics 365) is hosted and subscription-based — faster to deploy, easier to scale, lower IT overhead. Most new implementations go cloud, but we recommend by fit."}]]}]]}]]}]
