16:["$","section",null,{"id":"what-is","data-reveal":true,"className":"scroll-mt-24 border-b-hairline-soft py-20","children":[["$","div",null,{"className":"grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16","children":[["$","div",null,{"children":[["$","h2",null,{"className":"max-w-[20ch] font-display text-display-l font-extrabold text-fg [text-wrap:balance]","children":"What is CRM implementation?"}],["$","p",null,{"className":"mt-8 font-mono text-body text-fg-secondary","children":"CRM implementation is the process of selecting, configuring, and rolling out a customer relationship management platform — like Salesforce, HubSpot, or Microsoft Dynamics — to run sales, marketing, and customer service on one system, then migrating your data and getting your team to actually use it."}]]}],["$","figure",null,{"className":"relative aspect-[4/3] overflow-hidden rounded-2xl","children":["$","$L32",null,{"src":"/images/services/crm/what-is.webp","alt":"A consultant configuring a CRM — a deal pipeline and contact records unified into one customer view","fill":true,"sizes":"(max-width: 1024px) 100vw, 50vw","className":"object-cover"}]}]]}],["$","dl",null,{"className":"mt-12 grid grid-cols-1 gap-4 md:grid-cols-2","children":[["$","div","CRM vs. ERP — what's the difference?",{"className":"rounded-xl border-hairline bg-white/[0.015] p-6","children":[["$","dt",null,{"className":"font-display text-display-s font-bold text-fg","children":"CRM vs. ERP — what's the difference?"}],["$","dd",null,{"className":"mt-3 font-mono text-body text-fg-secondary","children":"A CRM runs the front office — sales, marketing, and customer service (the relationship). An ERP runs the back office — finance, inventory, and operations. They're complementary; connecting them gives you one customer-to-cash view."}]]}],["$","div","Cloud vs. on-premise CRM?",{"className":"rounded-xl border-hairline bg-white/[0.015] p-6","children":[["$","dt",null,{"className":"font-display text-display-s font-bold text-fg","children":"Cloud vs. on-premise CRM?"}],["$","dd",null,{"className":"mt-3 font-mono text-body text-fg-secondary","children":"Almost all modern CRMs are cloud — Salesforce, HubSpot, Dynamics 365 — hosted and subscription-based, fast to deploy and easy to scale. On-premise CRM is rare now; we recommend by fit, but it's usually cloud."}]]}]]}]]}]
