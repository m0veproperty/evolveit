10:T999,{"@context":"https://schema.org","@graph":[{"@id":"https://weevolveit.com#organization","@type":"Organization","name":"WeEvolveIT","alternateName":["We Evolve IT","We EvolveIT","WeEvolve IT","We Evolve","Evolve IT"],"url":"https://weevolveit.com","logo":"https://weevolveit.com/brand/logo-weevolveit-dark.svg","sameAs":["https://www.linkedin.com/company/weevolveit","https://www.instagram.com/weevolveit","https://www.facebook.com/weevolveit","https://www.tiktok.com/@weevolveit"],"foundingDate":"2010","founders":[],"address":{"@type":"PostalAddress","streetAddress":"Venustiano Carranza 601","addressLocality":"Monterrey","addressRegion":"Nuevo León","postalCode":"64710","addressCountry":"MX"},"areaServed":[{"@type":"Country","name":"Mexico"},{"@type":"Country","name":"United States"},{"@type":"Country","name":"United Arab Emirates"}]},{"@type":"WebSite","@id":"https://weevolveit.com#website","url":"https://weevolveit.com","name":"WeEvolveIT","publisher":{"@id":"https://weevolveit.com#organization"}},{"@type":"ProfessionalService","@id":"https://weevolveit.com#local-business","name":"WeEvolveIT","description":"AI specialists. A five-phase method — Discover, Diagnose, Design, Deliver, Evolve — that transforms how your business runs on technology. HQ Monterrey, presence in Dubai, 17 countries served.","url":"https://weevolveit.com","logo":"https://weevolveit.com/brand/logo-weevolveit-dark.svg","image":"https://weevolveit.com/opengraph-image.jpg","address":{"@type":"PostalAddress","streetAddress":"Venustiano Carranza 601","addressLocality":"Monterrey","addressRegion":"Nuevo León","postalCode":"64710","addressCountry":"MX"},"areaServed":[{"@type":"Country","name":"Mexico"},{"@type":"Country","name":"United States"},{"@type":"Country","name":"United Arab Emirates"}],"sameAs":["https://www.linkedin.com/company/weevolveit","https://www.instagram.com/weevolveit","https://www.facebook.com/weevolveit","https://www.tiktok.com/@weevolveit"],"foundingDate":"2010","priceRange":"$$","knowsLanguage":["es-MX","en-US"],"slogan":"your tech partner. evolved.","contactPoint":{"@type":"ContactPoint","contactType":"sales","url":"https://wa.me/19562721609?text=Hola%20WeEvolveIT%20%F0%9F%91%8B%20vi%20su%20sitio%20y%20me%20interesa%20su%20servicio%2C%20me%20gustar%C3%ADa%20platicar%20de%20mi%20proyecto.","availableLanguage":["Spanish","English"],"areaServed":["MX","US"]},"parentOrganization":{"@id":"https://weevolveit.com#organization"}}]}4:["$","html",null,{"lang":"en","className":"geist_mono_1bf8cbf6-module__FlyLvG__variable jetbrains_mono_84d6efd-module__5Hl15a__variable h-full antialiased","suppressHydrationWarning":true,"children":[["$","head",null,{"children":[["$","link",null,{"rel":"preconnect","href":"https://www.googletagmanager.com","crossOrigin":"anonymous"}],["$","link",null,{"rel":"preconnect","href":"https://ipapi.co","crossOrigin":"anonymous"}],["$","link",null,{"rel":"dns-prefetch","href":"https://www.googletagmanager.com"}],["$","link",null,{"rel":"dns-prefetch","href":"https://ipapi.co"}],["$","script",null,{"dangerouslySetInnerHTML":{"__html":"try {\n  if ('scrollRestoration' in history) history.scrollRestoration = 'manual';\n  window.scrollTo(0, 0);\n  var seenIntro = false;\n  try { seenIntro = !!sessionStorage.getItem('we_intro_seen'); } catch (e) {}\n  if (seenIntro || window.matchMedia('(prefers-reduced-motion: reduce)').matches || window.matchMedia('(max-width: 767px)').matches) {\n    document.documentElement.classList.add('intro-skip');\n  }\n} catch (e) {}"}}]]}],["$","body",null,{"className":"isolate min-h-full flex flex-col overflow-x-clip bg-bg text-fg font-mono","suppressHydrationWarning":true,"children":[["$","script",null,{"id":"site-schema","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11"]}]]}]
12:T193d,{"@context":"https://schema.org","@graph":[{"@type":"WebSite","@id":"https://weevolveit.com#website","url":"https://weevolveit.com","name":"WeEvolveIT","publisher":{"@id":"https://weevolveit.com#organization"}},{"@id":"https://weevolveit.com#organization","@type":"Organization","name":"WeEvolveIT","alternateName":["We Evolve IT","We EvolveIT","WeEvolve IT","We Evolve","Evolve IT"],"url":"https://weevolveit.com","logo":"https://weevolveit.com/brand/logo-weevolveit-dark.svg","sameAs":["https://www.linkedin.com/company/weevolveit","https://www.instagram.com/weevolveit","https://www.facebook.com/weevolveit","https://www.tiktok.com/@weevolveit"],"foundingDate":"2010","founders":[],"address":{"@type":"PostalAddress","streetAddress":"Venustiano Carranza 601","addressLocality":"Monterrey","addressRegion":"Nuevo León","postalCode":"64710","addressCountry":"MX"},"areaServed":[{"@type":"Country","name":"Mexico"},{"@type":"Country","name":"United States"},{"@type":"Country","name":"United Arab Emirates"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://weevolveit.com/"},{"@type":"ListItem","position":2,"name":"Services","item":"https://weevolveit.com/services"},{"@type":"ListItem","position":3,"name":"Industrial IoT","item":"https://weevolveit.com/services/industrial-iot"}]},{"@type":"Service","@id":"https://weevolveit.com/services/industrial-iot#service","name":"Industrial IoT","description":"Industrial IoT (IIoT) is connecting your machines, sensors, and production lines to software that turns their signals into decisions — connectivity and edge, an IoT platform and dashboards, and AI that predicts failures before they happen. It's the software and integration layer, not the hardware: we connect what you already run, on your cloud, and you own the platform.","serviceType":"Industrial IoT Solutions & Services","provider":{"@id":"https://weevolveit.com#organization"},"url":"https://weevolveit.com/services/industrial-iot","areaServed":[{"@type":"Country","name":"Mexico"},{"@type":"Country","name":"United States"},{"@type":"Country","name":"United Arab Emirates"}],"offers":{"@type":"Offer","priceCurrency":"USD","availability":"https://schema.org/InStock","url":"https://weevolveit.com/services/industrial-iot#contact"}},{"@type":"HowTo","name":"How we run an industrial IoT engagement","step":[{"@type":"HowToStep","position":1,"name":"Discover","text":"We map your machines, lines, and the failures or losses that hurt most — and what a connected operation is worth, with a costed plan."},{"@type":"HowToStep","position":2,"name":"Diagnose","text":"We assess your equipment, protocols, and OT/IT gaps, and decide what to connect first — finding the fastest wins."},{"@type":"HowToStep","position":3,"name":"Design","text":"We design the architecture — connectivity, edge, platform, dashboards, and AI — from machine signal to decision."},{"@type":"HowToStep","position":4,"name":"Deliver","text":"We connect the machines, build the platform and dashboards, and ship predictive maintenance — working IIoT you can see, the platform yours."},{"@type":"HowToStep","position":5,"name":"Evolve","text":"Operations are never done. We add lines, sensors, and AI — your plant gets smarter and more predictive as you scale."}]},{"@type":"CollectionPage","@id":"https://weevolveit.com/services/industrial-iot#page","url":"https://weevolveit.com/services/industrial-iot","name":"Industrial IoT | WeEvolveIT","description":"Industrial IoT (IIoT) is connecting your machines, sensors, and production lines to software that turns their signals into decisions — connectivity and edge, an IoT platform and dashboards, and AI that predicts failures before they happen. It's the software and integration layer, not the hardware: we connect what you already run, on your cloud, and you own the platform.","isPartOf":{"@id":"https://weevolveit.com#website"},"about":{"@type":"Service","name":"Industrial IoT"}},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is Industrial IoT (IIoT), and is this hardware or software?","acceptedAnswer":{"@type":"Answer","text":"It's the software and integration layer. We connect your existing machines, sensors, and PLCs to an IoT platform, build the dashboards and analytics, and add AI predictive maintenance — on your cloud, vendor-neutral. We don't sell you hardware; we make the equipment you already run intelligent."}},{"@type":"Question","name":"IIoT vs IoT — what's the difference?","acceptedAnswer":{"@type":"Answer","text":"Consumer IoT is smart homes and wearables. Industrial IoT connects factories, machines, and infrastructure, where uptime, safety, and integration with OT systems (PLCs, SCADA, MES) matter. The stakes and ROI are higher, and the integration is harder — which is exactly what we specialize in."}},{"@type":"Question","name":"Do you integrate with my ERP, MES, or SCADA?","acceptedAnswer":{"@type":"Answer","text":"Yes. IIoT only pays off when the data reaches your decisions. We wire it into your ERP, MES, SCADA, and historian, and speak the protocols your machines use — MQTT, OPC-UA, Modbus, and more — so the floor and the office finally share one source of truth."}},{"@type":"Question","name":"How does IoT predictive maintenance work?","acceptedAnswer":{"@type":"Answer","text":"We stream sensor data — vibration, temperature, current — to the platform, then use anomaly detection and machine-learning models to flag a failing motor, bearing, or pump before it stops the line. You fix it on a schedule, not in an emergency, and cut unplanned downtime."}},{"@type":"Question","name":"How much does an industrial IoT project cost?","acceptedAnswer":{"@type":"Answer","text":"It depends on how many machines and lines, and your goals. We work three ways: Agentic Operations as a monthly productized service, a fixed-scope project priced up front, or a dedicated nearshore IoT team from $50 USD/hour. Senior nearshore costs a fraction of an OEM engagement — and you own everything we build."}},{"@type":"Question","name":"Is it vendor-neutral, and do I own the platform?","acceptedAnswer":{"@type":"Answer","text":"Yes to both. We're not tied to one OEM or cloud — connect any sensor, PLC, or platform (AWS IoT, Azure IoT, or your own). Your platform, dashboards, code, and data are yours, with no black-box lock-in. You can run it, extend it, or take it anywhere."}}]}]}5:["$","main",null,{"className":"mx-auto max-w-[1400px] px-6","children":[["$","script",null,{"id":"industrial-iot-schema","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$12"}}],"$L13","$L14","$L15",["$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21"],"$L22","$L23","$L24","$L25"]}]
