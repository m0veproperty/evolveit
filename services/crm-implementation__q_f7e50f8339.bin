1f:["$","section",null,{"id":"cost","data-reveal":true,"className":"scroll-mt-24 border-b-hairline-soft py-20","children":[["$","p",null,{"className":"font-mono text-label uppercase text-fg-muted [letter-spacing:var(--tracking-label)]","children":"Cost & engagement"}],["$","h2",null,{"className":"mt-4 max-w-[24ch] font-display text-display-l font-extrabold text-fg [text-wrap:balance]","children":"Scoped to your rollout — from $50 USD an hour."}],["$","p",null,{"className":"mt-8 font-mono text-body text-fg-secondary","children":"CRM cost depends on the platform, users, integrations, and data. Senior certified consulting starts at $50 USD/hour, and ongoing adoption support runs hourly or as a fixed monthly retainer. We scope a fixed-price discovery first, so you see a predictable number before the build."}],["$","div",null,{"className":"mt-10 rounded-xl border-hairline bg-white/[0.015] p-6 sm:p-8","children":[["$","p",null,{"className":"font-mono text-label-s uppercase text-accent [letter-spacing:var(--tracking-label-tight)]","children":"Adoption-driven · AI-first"}],["$","p",null,{"className":"mt-3 font-mono text-body text-fg-secondary","children":"A CRM only pays back if the team uses it. We measure adoption, not just go-live, and add AI so the CRM does more of the work — follow-ups, scoring, and quotes — and your reps spend more time selling."}]]}],["$","ul",null,{"data-reveal-stagger":true,"className":"mt-8 grid grid-cols-1 gap-4 sm:grid-cols-3","children":[["$","li","Implementation project",{"className":"flex flex-col rounded-xl border-hairline bg-white/[0.015] p-6","children":[["$","span",null,{"className":"font-mono text-label-s uppercase text-fg-muted [letter-spacing:var(--tracking-label-tight)]","children":"Fixed scope · milestones"}],["$","h3",null,{"className":"mt-3 font-display text-display-s font-bold text-fg","children":"Implementation project"}],["$","p",null,{"className":"mt-2 font-mono text-body-sm text-fg-secondary","children":"Sized to your platform