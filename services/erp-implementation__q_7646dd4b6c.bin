1a:["$","section",null,{"id":"rollout","data-reveal":true,"className":"scroll-mt-24 border-b-hairline-soft py-20","children":["$","div",null,{"className":"grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16","children":[["$","div",null,{"children":[["$","p",null,{"className":"font-mono text-label uppercase text-accent [letter-spacing:var(--tracking-label)]","children":"How the rollout works"}],["$","h2",null,{"className":"mt-4 max-w-[24ch] font-display text-display-l font-extrabold text-fg [text-wrap:balance]","children":"An ERP system implementation, step by step."}],"$undefined",["$","p",null,{"className":"mt-8 font-mono text-body text-fg-secondary","children":"We run your ERP system implementation as a phased, fixed-scope sequence — scope and select the right ERP, configure it to your workflows, migrate clean data, train your team, and go live module by module, with rollback at every step."}],"$undefined"]}],["$","$L38",null,{"steps":[{"img":"01-scope","label":"Scope & select","caption":"We map your processes, modules, and data, and pick the right-fit ERP."},{"img":"02-configure","label":"Configure","caption":"We configure the platform to your workflows — config over custom code."},{"img":"03-migrate","label":"Migrate clean data","caption":"We map, cleanse, and validate your data before a single record moves."},{"img":"04-train","label":"Train & test","caption":"UAT and change management so the team actually adopts it."},{"img":"05-golive","label":"Go live & evolve","caption":"Phased go-live with rollback, then ongoing optimization."}],"basePath":"/images/services/erp/build-flow"}]]}]}]
1b:["$","section",null,{"id":"vendors","data-reveal":true,"className":"scroll-mt-24 border-b-hairline-soft py-20","children":[["$","p",null,{"className":"font-mono text-label uppercase text-fg-muted [letter-spacing:var(--tracking-label)]","children":"Vendors we implement"}],["$","h2",null,{"className":"mt-4 max-w-[26ch] font-display text-display-l font-extrabold text-fg [text-wrap:balance]","children":"The right ERP for your business — not the one we resell."}],["$","p",null,{"className":"mt-8 font-mono text-body text-fg-secondary","children":"Standing up an ERP from scratch — or switching to a better one — is complex and high-stakes. The right system isn't the most expensive, the most sophisticated, or the most complex; it's the one your business actually needs — whether that's a NetSuite or Odoo implementation, an SAP or Dynamics rollout, or Acumatica. As consultants, our job is to save you money: we're integrators and analysts who find the best-fit solution, vendor-neutral and certified across the major platforms — never commodity sellers pushing a license."}],["$","ul",null,{"className":"mt-8 flex flex-wrap items-center justify-center gap-x-12 gap-y-9 sm:gap-x-16","children":[["$","li","SAP",{"className":"flex items-center","children":["$","img",null,{"src":"/logos/sap.svg","alt":"SAP","title":"SAP","loading":"lazy","className":"h-9 w-auto opacity-55 transition-opacity duration-300 [filter:invert(1)] hover:opacity-90 sm:h-11"}]}],["$","li","NetSuite",{"className":"flex items-center","children":["$","span",null,{"title":"NetSuite","className":"font-display text-display-m font-bold text-fg-secondary/80 transition-colors hover:text-fg","children":"NetSuite"}]}],["$","li","Odoo",{"className":"flex items-center","children":["$","img",null,{"src":"/logos/odoo.svg","alt":"Odoo","title":"Odoo","loading":"lazy","className":"h-9 w-auto opacity-55 transition-opacity duration-300 [filter:invert(1)] hover:opacity-90 sm:h-11"}]}],["$","li","Microsoft Dynamics 365",{"className":"flex items-center","children":["$","span",null,{"title":"Microsoft Dynamics 365","className":"font-display text-display-m font-bold text-fg-secondary/80 transition-colors hover:text-fg","children":"Dynamics 365"}]}],["$","li","Oracle",{"className":"flex items-center","children":["$","img",null,{"src":"/logos/oracle.svg","alt":"Oracle","title":"Oracle","loading":"lazy","className":"h-9 w-auto opacity-55 transition-opacity duration-300 [filter:invert(1)] hover:opacity-90 sm:h-11"}]}],["$","li","Acumatica",{"className":"flex items-center","children":["$","span",null,{"title":"Acumatica","className":"font-display text-display-m font-bold text-fg-secondary/80 transition-colors hover:text-fg","children":"Acumatica"}]}],["$","li","QuickBooks",{"className":"flex items-center","children":["$","img",null,{"src":"/logos/quickbooks.svg","alt":"QuickBooks","title":"QuickBooks","loading":"lazy","className":"h-9 w-auto opacity-55 transition-opacity duration-300 [filter:invert(1)] hover:opacity-90 sm:h-11"}]}]]}]]}]
1c:["$","section",null,{"id":"ai-erp","data-reveal":true,"className":"scroll-mt-24 border-b-hairline-soft py-20","children":[["$","p",null,{"className":"font-mono text-label uppercase text-accent [letter-spacing:var(--tracking-label)]","children":"AI ERP · the next evolution"}],["$","h2",null,{"className":"mt-4 max-w-[26ch] font-display text-display-l font-extrabold text-fg [text-wrap:balance]","children":"Already have an ERP? We make it think."}],"$undefined",["$","p",null,{"className":"mt-8 font-mono text-body text-fg-secondary","children":"With AI, ERPs are evolving into agentic systems that don't just store your data — they act on it. You don't have to rip and replace to get there. If you already run an ERP, we connect AI agents under your company's umbrella, across all of your available data, to supercharge the work: deeper analysis, faster quotes, and automation of the processes that eat your team's time."}],["$","ul",null,{"data-reveal-stagger":true,"className":"mt-12 grid grid-cols-1 gap-4 md:grid-cols-3","children":[["$","li","Agents over your data",{"className":"flex flex-col rounded-xl border-hairline bg-white/[0.015] p-6","children":[["$","span",null,{"aria-hidden":true,"className":"mb-3 h-1.5 w-1.5 rounded-full bg-accent"}],["$","h3",null,{"className":"font-display text-display-s font-bold text-fg","children":"Agents over your data"}],["$","p",null,{"className":"mt-2 font-mono text-body-sm text-fg-secondary","children":"AI agents connected under your company's umbrella — across everything your ERP and business already hold, with full context."}]]}],["$","li","Smarter analysis & quoting",{"className":"flex flex-col rounded-xl border-hairline bg-white/[0.015] p-6","children":[["$","span",null,{"aria-hidden":true,"className":"mb-3 h-1.5 w-1.5 rounded-full bg-accent"}],["$","h3",null,{"className":"font-display text-display-s font-bold text-fg","children":"Smarter analysis & quoting"}],["$","p",null,{"className":"mt-2 font-mono text-body-sm text-fg-secondary