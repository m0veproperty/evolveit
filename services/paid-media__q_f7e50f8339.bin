16:["$","section",null,{"id":"what-is","data-reveal":true,"className":"scroll-mt-24 border-b-hairline-soft py-20","children":[["$","div",null,{"className":"grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16","children":[["$","div",null,{"children":[["$","h2",null,{"className":"max-w-[20ch] font-display text-display-l font-extrabold text-fg [text-wrap:balance]","children":"What is paid media?"}],["$","p",null,{"className":"mt-8 font-mono text-body text-fg-secondary","children":"Paid media (PPC — pay-per-click, also called paid search or SEM) is advertising you pay for to appear instantly at the top of search and social — Google Ads, Meta/Facebook, and more. You bid to reach people actively searching or matching your audience, and pay per click or impression. Done right, it's the fastest way to buy qualified traffic and measurable ROI; done wrong, it quietly burns budget."}]]}],["$","figure",null,{"className":"relative aspect-[4/3] overflow-hidden rounded-2xl border-hairline","children":["$","$L31",null,{"src":"/images/services/paid-media/what-is.webp","alt":"Paid ads across search and social flowing into a tracking and analytics layer where conversions are measured","fill":true,"sizes":"(max-width:1024px) 100vw, 50vw","className":"object-cover"}]}]]}],["$","dl",null,{"className":"mt-12 grid grid-cols-1 gap-4 md:grid-cols-2","children":[["$","div","PPC vs. SEO — what's the difference?",{"className":"rounded-xl border-hairline bg-white/[0.015] p-6","children":[["$","dt",null,{"className":"font-display text-display-s font-bold text-fg","children":"PPC vs. SEO — what's the difference?"}],["$","dd",null,{"className":"mt-3 font-mono text-body text-fg-secondary","children":"PPC buys instant visibility — you appear at the top today, but the traffic stops when the budget does. SEO earns rankings that compound and keep working without paying per click. PPC is fast and rented; SEO is slow and owned. Most businesses win with both — ads now, SEO compounding underneath."}]]}],["$","div","% of ad spend vs. a flat fee?",{"className":"rounded-xl border-hairline bg-white/[0.015] p-6","children":[["$","dt",null,{"className":"font-display text-display-s font-bold text-fg","children":"% of ad spend vs. a flat fee?"}],["$","dd",null,{"className":"mt-3 font-mono text-body text-fg-secondary","children":"Many agencies charge a percentage of your ad spend — which rewards them for making you spend MORE. We charge a transparent flat management fee, so we're aligned with your results, not your budget."}]]}],["$","div","Is it just running ads?",{"className":"rounded-xl border-hairline bg-white/[0.015] p-6","children":[["$","dt",null,{"className":"font-display text-display-s font-bold text-fg","children":"Is it just running ads?"}],["$","dd",null,{"className":"mt-3 font-mono text-body text-fg-secondary","children":"No — it's an integral service, end to end. We don't just run pretty ads: we set up proper tracking with Google Tag Manager and Google Analytics (GA4) so every conversion scenario is measured, build the landing pages, and plan the strategy. From setup to optimization, the whole funnel."}]]}]]}]]}]
