20:["$","section",null,{"id":"cost","data-reveal":true,"className":"scroll-mt-24 border-b-hairline-soft py-20","children":[["$","p",null,{"className":"font-mono text-label uppercase text-fg-muted [letter-spacing:var(--tracking-label)]","children":"Cost & engagement"}],["$","h2",null,{"className":"mt-4 max-w-[24ch] font-display text-display-l font-extrabold text-fg [text-wrap:balance]","children":"Scoped to your system — from $50 USD an hour."}],["$","p",null,{"className":"mt-8 font-mono text-body text-fg-secondary","children":"Modernization cost depends on the size and complexity of the system and how much you rebuild. Senior certified engineering starts at $50 USD/hour, and we scope a fixed-price assessment first, so you see the plan and the cost before any change. Doing nothing has a cost too — and it rises every year."}],["$","div",null,{"className":"mt-10 rounded-xl border-hairline bg-white/[0.015] p-6 sm:p-8","children":[["$","p",null,{"className":"font-mono text-label-s uppercase text-accent [letter-spacing:var(--tracking-label-tight)]","children":"Cheaper than standing still · AI-accelerated"}],["$","p",null,{"className":"mt-3 font-mono text-body text-fg-secondary","children":"Legacy maintenance, licenses, and scarce specialists cost more every year. Modernization usually pays back in lower run cost and faster delivery — and AI decoding the old code makes the work faster still."}]]}],["$","ul",null,{"data-reveal-stagger":true,"className":"mt-8 grid grid-cols-1 gap-4 sm:grid-cols-3","children":[["$","li","Modernization roadmap",{"className":"flex flex-col rounded-xl border-hairline bg-white/[0.015] p-6","children":[["$","span",null,{"className":"font-mono text-label-s uppercase text-fg-muted [letter-spacing:var(--tracking-label-tight)]","children":"Fixed scope · assessment"}],["$","h3",null,{"className":"mt-3 font-display text-display-s font-bold text-fg","children":"Modernization roadmap"}],["$","p",null,{"className":"mt-2 font-mono text-body-sm text-fg-secon