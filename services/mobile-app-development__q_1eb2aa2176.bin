16:["$","section",null,{"id":"what-is","data-reveal":true,"className":"scroll-mt-24 border-b-hairline-soft py-20","children":[["$","div",null,{"className":"grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16","children":[["$","div",null,{"children":[["$","h2",null,{"className":"max-w-[22ch] font-display text-display-l font-extrabold text-fg [text-wrap:balance]","children":"What is mobile app development?"}],["$","p",null,{"className":"mt-8 font-mono text-body text-fg-secondary","children":"Mobile app development is designing, building, and shipping the iOS and Android apps your business runs on — from a custom app for your customers to an internal tool for your team. We build cross-platform (one codebase for both stores) and native, wired into your backend, shipped to the App Store and Google Play, and kept alive after launch."}]]}],["$","figure",null,{"className":"relative aspect-[4/3] overflow-hidden rounded-2xl border-hairline","children":["$","$L33",null,{"src":"/images/services/mobile-app-development/what-is.webp","alt":"A cross-platform mobile app running on iOS and Android, built from one codebase and connected to a backend","fill":true,"sizes":"(max-width:1024px) 100vw, 50vw","className":"object-cover"}]}]]}],["$","dl",null,{"className":"mt-12 grid grid-cols-1 gap-4 md:grid-cols-2","children":[["$","div","Cross-platform vs native — which should you build?",{"className":"rounded-xl border-hairline bg-white/[0.015] p-6","children":[["$","dt",null,{"className":"font-display text-display-s font-bold text-fg","children":"Cross-platform vs native — which should you build?"}],["$","dd",null,{"className":"mt-3 font-mono text-body text-fg-secondary","children":"Native (separate iOS and Android codebases) gives maximum performance for heavy, hardware-intensive apps. Cross-platform (one React Native or Flutter codebase for both) ships faster and costs less for most business apps — same app, both stores, one team. We recommend based on your app, not our preference."}]]}],["$","div","How much does a mobile app cost?",{"className":"rounded-xl border-hairline bg-white/[0.015] p-6","children":[["$","dt",null,{"className":"font-display text-display-s font-bold text-fg","children":"How much does a mobile app cost?"}],["$","dd",null,{"className":"mt-3 font-mono text-body text-fg-secondary","children":"Most custom apps land between roughly $30K for a focused MVP and $250K+ for a complex, multi-feature product — driven by screens, integrations, and platforms. We quote a fixed number after a discovery, and cross-platform usually cuts the cost of covering both stores roughly in half."}]]}]]}]]}]
