16:["$","section",null,{"id":"what-is","data-reveal":true,"className":"scroll-mt-24 border-b-hairline-soft py-20","children":[["$","div",null,{"className":"grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16","children":[["$","div",null,{"children":[["$","h2",null,{"className":"max-w-[22ch] font-display text-display-l font-extrabold text-fg [text-wrap:balance]","children":"What is custom software development?"}],["$","p",null,{"className":"mt-8 font-mono text-body text-fg-secondary","children":"Custom software development is building software tailored to your exact business — your workflows, your data, your rules — instead of forcing your operation into off-the-shelf tools. Web and mobile apps, internal platforms, integrations, and SaaS products, built to fit and yours to own. Done right, it removes the friction generic tools can't, and becomes a real competitive advantage."}]]}],["$","figure",null,{"className":"relative aspect-[4/3] overflow-hidden rounded-2xl border-hairline","children":["$","$L32",null,{"src":"/images/services/custom-software-development/what-is.webp","alt":"A senior engineering team building custom software — code, terminal and architecture on screen, La M de Chipinque through the window","fill":true,"sizes":"(max-width:1024px) 100vw, 50vw","className":"object-cover"}]}]]}],["$","dl",null,{"className":"mt-12 grid grid-cols-1 gap-4 md:grid-cols-2","children":[["$","div","Custom vs. off-the-shelf software?",{"className":"rounded-xl border-hairline bg-white/[0.015] p-6","children":[["$","dt",null,{"className":"font-display text-display-s font-bold text-fg","children":"Custom vs. off-the-shelf software?"}],["$","dd",null,{"className":"mt-3 font-mono text-body text-fg-secondary","children":"Off-the-shelf software makes you adapt to it — generic features, fees forever, and limits you can't change. Custom software is built around YOUR workflow, integrates with what you already use, and is yours to own and evolve. Off-the-shelf is faster to start; custom fits and compounds."}]]}],["$","div","Do I own the code and IP?",{"className":"rounded-xl border-hairline bg-white/[0.015] p-6","children":[["$","dt",null,{"className":"font-display text-display-s font-bold text-fg","children":"Do I own the code and IP?"}],["$","dd",null,{"className":"mt-3 font-mono text-body text-fg-secondary","children":"Yes — always. Everything we build is yours: the source code, the IP, the data. No lock-in, no hostage situations. You can host it, extend it, or take it elsewhere whenever you want."}]]}]]}]]}]
