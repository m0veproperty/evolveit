1d:["$","section",null,{"id":"why-us","data-reveal":true,"className":"scroll-mt-24 border-b-hairline-soft py-20","children":[["$","p",null,{"className":"font-mono text-label uppercase text-fg-muted [letter-spacing:var(--tracking-label)]","children":"Why WeEvolveIT"}],["$","h2",null,{"className":"mt-4 max-w-[26ch] font-display text-display-l font-extrabold text-fg [text-wrap:balance]","children":"The GEO agency that ranks for GEO — by doing GEO."}],"$undefined",["$","p",null,{"className":"mt-8 font-mono text-body text-fg-secondary","children":"We're an AI SEO agency built for the AI-search era — a generative engine optimization agency where AI search optimization is the whole job, not a bolt-on. We run SEO, AEO, and GEO as one strategy, we measure your AI citations instead of guessing, and we're early — the brands that get cited now own the answers later. As an AI-native team that builds agents and automation, we understand how the models actually retrieve and cite. Among generative engine optimization companies, we're the one that can prove it — 1,000+ projects across 17 countries in 15+ years, run from our Monterrey headquarters, nearshore to the US."}],["$","ul",null,{"data-reveal-stagger":true,"className":"mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4","children":[["$","li","Get cited, not just ranked",{"className":"flex flex-col rounded-xl border-hairline bg-white/[0.015] p-6","children":[false,["$","h3",null,{"className":"font-display text-display-s font-bold text-fg","children":"Get cited, not just ranked"}],["$","p",null,{"className":"mt-2 font-mono text-body-sm text-fg-secondary","children":"Be the source AI quotes — the new #1."}]]}],["$","li","SEO + AEO + GEO",{"className":"flex flex-col rounded-xl border-hairline bg-white/[0.015] p-6","children":[false,["$","h3",null,{"className":"font-display text-display-s font-bold text-fg","children":"SEO + AEO + GEO"}],["$","p",null,{"className":"mt-2 font-mono text-body-sm text-fg-secondary","children":