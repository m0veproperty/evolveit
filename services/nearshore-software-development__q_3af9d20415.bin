16:["$","section",null,{"id":"what-is","data-reveal":true,"className":"scroll-mt-24 border-b-hairline-soft py-20","children":[["$","div",null,{"className":"grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16","children":[["$","div",null,{"children":[["$","h2",null,{"className":"max-w-[20ch] font-display text-display-l font-extrabold text-fg [text-wrap:balance]","children":"What is nearshore software development?"}],["$","p",null,{"className":"mt-8 font-mono text-body text-fg-secondary","children":"Nearshore software development is hiring a software team in a nearby country — in your time zone — instead of offshore (a 12-hour gap) or building in-house. For US companies, Mexico is the prime nearshore hub: overlapping work hours, cultural alignment, and senior engineers at a fraction of US rates."}]]}],["$","figure",null,{"className":"relative aspect-[4/3] overflow-hidden rounded-2xl","children":["$","$L31",null,{"src":"/images/services/nearshore/what-is.webp","alt":"A nearshore engineering pair collaborating in real time on code and UI","fill":true,"sizes":"(max-width: 1024px) 100vw, 50vw","className":"object-cover"}]}]]}],["$","dl",null,{"className":"mt-12 grid grid-cols-1 gap-4 md:grid-cols-2","children":[["$","div","Nearshore vs. offshore — what's the difference?",{"className":"rounded-xl border-hairline bg-white/[0.015] p-6","children":[["$","dt",null,{"className":"font-display text-display-s font-bold text-fg","children":"Nearshore vs. offshore — what's the difference?"}],["$","dd",null,{"className":"mt-3 font-mono text-body text-fg-secondary","children":"Offshore means a far-away country with a big time-zone gap (e.g. US → India, ~10-12 hours). Nearshore means a nearby country in your time zone (US → Mexico, 0-2 hours). Same talent quality, but you collaborate in real time instead of waiting a day for every reply."}]]}],["$","div","Nearshore vs. in-house hiring?",{"className":"rounded-xl border-hairline bg-white/[0.015] p-6","children":[["$","dt",null,{"className":"font-display text-display-s font-bold text-fg","children":"Nearshore vs. in-house hiring?"}],["$","dd",null,{"className":"mt-3 font-mono text-body text-fg-secondary","children":"In-house gives full control but costs US salaries and months of recruiting. Nearshore gives you senior engineers in days, at a fraction of the cost, who work your hours and integrate into your team — without the overhead of full-time US headcount."}]]}]]}]]}]
