1a:["$","section",null,{"id":"compare","data-reveal":true,"className":"scroll-mt-24 border-b-hairline-soft py-20","children":[["$","p",null,{"className":"font-mono text-label uppercase text-fg-muted [letter-spacing:var(--tracking-label)]","children":"Know the difference"}],["$","h2",null,{"className":"mt-4 max-w-[24ch] font-display text-display-l font-extrabold text-fg [text-wrap:balance]","children":"Traditional automation vs AI automation vs AI agents."}],"$undefined","$undefined",["$","ul",null,{"data-reveal-stagger":true,"className":"mt-12 grid grid-cols-1 gap-4 md:grid-cols-3","children":[["$","li","Traditional automation",{"className":"flex flex-col rounded-2xl border-hairline bg-white/[0.015] p-7","children":[false,["$","h3",null,{"className":"font-display text-display-m font-extrabold text-fg","children":"Traditional automation"}],["$","p",null,{"className":"mt-3 font-mono text-body-sm text-fg-secondary","children":"Runs fixed, rule-based steps. Fast and reliable — but rigid, and it breaks on anything off the script."}]]}],["$","li","AI automation",{"className":"flex flex-col rounded-2xl border-hairline bg-white/[0.015] p-7","children":[false,["$","h3",null,{"className":"font-display text-display-m font-extrabold text-fg","children":"AI automation"}],["$","p",null,{"className":"mt-3 font-mono text-body-sm text-fg-secondary","children":"Adds AI inside the workflow — reading, deciding, and handling exceptions, so the process keeps running on its own."}]]}],["$","li","AI agents",{"className":"flex flex-col rounded-2xl border-hairline bg-white/[0.015] p-7","children":[false,["$","h3",null,{"className":"font-display text-display-m font-extrabold text-fg","children":"AI agents"}],["$","p",null,{"className":"mt-3 font-mono text-body-sm text-fg-secondary","children":"Fully autonomous: the agent plans and acts toward a goal across systems — the next step up from automation."}]]}]]}],"$undefined","$undefined"]}]
1b:["$","section",null,{"id":"build","data-reveal":true,"className":"scroll-mt-24 border-b-hairline-soft py-20","children":["$","div",null,{"className":"grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16","children":[["$","div",null,{"children":[["$","p",null,{"className":"font-mono text-label uppercase text-accent [letter-spacing:var(--tracking-label)]","children":"How it works · from manual to automated"}],["$","h2",null,{"className":"mt-4 max-w-[24ch] font-display text-display-l font-extrabold text-fg [text-wrap:balance]","children":"How we turn a manual process into a reliable automation."}],"$undefined",["$","p",null,{"className":"mt-8 font-mono text-body text-fg-secondary","children":"Most automation projects fail for two reasons: they automate the wrong thing, or they break on the first exception. We start from where your team actually loses time, design a flow that's built to change, wire your tools together, add AI where the rules fall short, and monitor it in production. That's the difference between a brittle script and a process that runs itself."}],["$","ul",null,{"className":"mt-8 space-y-4","children":[["$","li","Scoped by ROI",{"className":"flex gap-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[0.5em] h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","p",null,{"className":"font-mono text-body-sm text-fg-secondary","children":[["$","span",null,{"className":"font-bold text-fg","children":"Scoped by ROI"}]," — ","We automate the bottleneck that eats time — not the easy, low-value steps."]}]]}],["$","li","AI where rules break",{"className":"flex gap-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[0.5em] h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","p",null,{"className":"font-mono text-body-sm text-fg-secondary","children":[["$","span",null,{"className":"font-bold text-fg","children":"AI where rules break"}]," — ","Reasoning and extraction for the exceptions that stall rule-based tools."]}]]}],["$","li","Integrated & monitored",{"className":"flex gap-3","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[0.5em] h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","p",null,{"className":"font-mono text-body-sm text-fg-secondary","children":[["$","span",null,{"className":"font-bold text-fg","children":"Integrated & monitored"}]," — ","Wired into your stack, with alerts and dashboards so it never silently fails."]}]]}]]}]]}],["$","$L33",null,{"steps":[{"img":"01-map","label":"Map the process","caption":"We map the workflow and find where the time and the errors actually go."},{"img":"02-design","label":"Design the flow","caption":"We design the automation: the triggers, the steps, and where AI makes the calls."},{"img":"03-connect","label":"Connect your tools","caption":"We wire your apps, ERP, CRM, and data so everything flows automatically."},{"img":"04-add-ai","label":"Add the AI","caption":"AI reads documents and handles the exceptions that rule-based tools can't."},{"img":"05-run","label":"Run & monitor","caption":"We deploy with alerts and dashboards, then keep tuning it as it runs."}],"basePath":"/images/services/ai-automation/auto-flow"}]]}]}]
