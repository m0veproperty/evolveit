"$$","knowsLanguage":["es-MX","en-US"],"slogan":"your tech partner. evolved.","contactPoint":{"@type":"ContactPoint","contactType":"sales","url":"https://wa.me/19562721609?text=Hola%20WeEvolveIT%20%F0%9F%91%8B%20vi%20su%20sitio%20y%20me%20interesa%20su%20servicio%2C%20me%20gustar%C3%ADa%20platicar%20de%20mi%20proyecto.","availableLanguage":["Spanish","English"],"areaServed":["MX","US"]},"parentOrganization":{"@id":"https://weevolveit.com#organization"}}]}4:["$","html",null,{"lang":"en","className":"geist_mono_1bf8cbf6-module__FlyLvG__variable jetbrains_mono_84d6efd-module__5Hl15a__variable h-full antialiased","suppressHydrationWarning":true,"children":[["$","head",null,{"children":[["$","link",null,{"rel":"preconnect","href":"https://www.googletagmanager.com","crossOrigin":"anonymous"}],["$","link",null,{"rel":"preconnect","href":"https://ipapi.co","crossOrigin":"anonymous"}],["$","link",null,{"rel":"dns-prefetch","href":"https://www.googletagmanager.com"}],["$","link",null,{"rel":"dns-prefetch","href":"https://ipapi.co"}],["$","script",null,{"dangerouslySetInnerHTML":{"__html":"try {\n  if ('scrollRestoration' in history) history.scrollRestoration = 'manual';\n  window.scrollTo(0, 0);\n  var seenIntro = false;\n  try { seenIntro = !!sessionStorage.getItem('we_intro_seen'); } catch (e) {}\n  if (seenIntro || window.matchMedia('(prefers-reduced-motion: reduce)').matches || window.matchMedia('(max-width: 767px)').matches) {\n    document.documentElement.classList.add('intro-skip');\n  }\n} catch (e) {}"}}]]}],["$","body",null,{"className":"isolate min-h-full flex flex-col overflow-x-clip bg-bg text-fg font-mono","suppressHydrationWarning":true,"children":[["$","script",null,{"id":"site-schema","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11"]}]]}]
12:T19ea,{"@context":"https://schema.org","@graph":[{"@type":"WebSite","@id":"https://weevolveit.com#website","url":"https://weevolveit.com","name":"WeEvolveIT","publisher":{"@id":"https://weevolveit.com#organization"}},{"@id":"https://weevolveit.com#organization","@type":"Organization","name":"WeEvolveIT","alternateName":["We Evolve IT","We EvolveIT","WeEvolve IT","We Evolve","Evolve IT"],"url":"https://weevolveit.com","logo":"https://weevolveit.com/brand/logo-weevolveit-dark.svg","sameAs":["https://www.linkedin.com/company/weevolveit","https://www.instagram.com/weevolveit","https://www.facebook.com/weevolveit","https://www.tiktok.com/@weevolveit"],"foundingDate":"2010","founders":[],"address":{"@type":"PostalAddress","streetAddress":"Venustiano Carranza 601","addressLocality":"Monterrey","addressRegion":"Nuevo León","postalCode":"64710","addressCountry":"MX"},"areaServed":[{"@type":"Country","name":"Mexico"},{"@type":"Country","name":"United States"},{"@type":"Country","name":"United Arab Emirates"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://weevolveit.com/"},{"@type":"ListItem","position":2,"name":"Services","item":"https://weevolveit.com/services"},{"@type":"ListItem","position":3,"name":"SEO Services","item":"https://weevolveit.com/services/seo"}]},{"@type":"Service","@id":"https://weevolveit.com/services/seo#service","name":"SEO Services","description":"SEO (search engine optimization) is the work of earning organic visibility in search — technical health, content, and authority that move your pages up Google — and, increasingly, GEO and AEO: getting your business cited by ChatGPT, Perplexity, and Google's AI answers. The goal is qualified traffic that compounds over time, without paying per click.","serviceType":"SEO, GEO & AEO Services","provider":{"@id":"https://weevolveit.com#organization"},"url":"https://weevolveit.com/services/seo","areaServed":[{"@type":"Country","name":"Mexico"},{"@type":"Country","name":"United States"},{"@type":"Country","name":"United Arab Emirates"}],"offers":{"@type":"Offer","priceCurrency":"USD","availability":"https://schema.org/InStock","url":"https://weevolveit.com/services/seo#contact"}},{"@type":"HowTo","name":"How we run an SEO engagement","step":[{"@type":"HowToStep","position":1,"name":"Discover","text":"We research your market, keywords, competitors, and the searches that convert — a fixed-scope audit with a costed SEO roadmap."},{"@type":"HowToStep","position":2,"name":"Diagnose","text":"We assess technical health, content gaps, local presence, and AI-citation potential — and find the fastest wins."},{"@type":"HowToStep","position":3,"name":"Design","text":"We design the strategy — the keyword map, the content plan, the technical fixes, and the local + GEO/AEO plays."},{"@type":"HowToStep","position":4,"name":"Deliver","text":"We execute — technical fixes, content, local optimization, and GEO/AEO — and report transparently every month."},{"@type":"HowToStep","position":5,"name":"Evolve","text":"Continuous improvement. SEO is never done — we keep adapting to algorithm changes and the shift to AI search, so your visibility keeps growing."}]},{"@type":"CollectionPage","@id":"https://weevolveit.com/services/seo#page","url":"https://weevolveit.com/services/seo","name":"SEO Services | WeEvolveIT","description":"SEO (search engine optimization) is the work of earning organic visibility in search — technical health, content, and authority that move your pages up Google — and, increasingly, GEO and AEO: getting your business cited by ChatGPT, Perplexity, and Google's AI answers. The goal is qualified traffic that compounds over time, without paying per click.","isPartOf":{"@id":"https://weevolveit.com#website"},"about":{"@type":"Service","name":"SEO Services"}},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What are SEO services, and what do they include?","acceptedAnswer":{"@type":"Answer","text":"Professional SEO services earn your business organic visibility in search. A full-service SEO company typically includes technical SEO (site health, speed, structured data), on-page and content (keyword-mapped pages that rank), local SEO (Google Business Profile, 'near me'), link building, and SEO consulting. We also include GEO/AEO — getting cited by AI search engines — which most agencies don't offer yet."}},{"@type":"Question","name":"What is GEO / AEO, and why do I need it now?","acceptedAnswer":{"@type":"Answer","text":"GEO (generative engine optimization) and AEO (answer engine optimization) get your business cited by ChatGPT, Perplexity, and Google's AI answers. Search is shifting from ten blue links to AI giving one answer and citing a few sources. Ranking #1 on Google no longer guarantees you're seen — you also have to be in the AI's answer. We do both."}},{"@type":"Question","name":"How long does SEO take to work?","acceptedAnswer":{"@type":"Answer","text":"Local and technical wins can show in weeks; competitive organic rankings typically take a few months to build and then compound. SEO is an investment that keeps paying after you stop spending — unlike ads. We report transparently every month so you see the progress, not just the bill."}},{"@type":"Question","name":"How much do SEO services cost?","acceptedAnswer":{"@type":"Answer","text":"It depends on competitiveness and scope. Our Agentic AI Writer starts at $250 USD/month; senior SEO work starts at $50 USD/hour. Most engagements are a monthly retainer because SEO compounds, and we also offer one-time audits. We scope it up front so you see what you're paying for — and we report the keywords and rankings, no black box."}},{"@type":"Question","name":"Do you do local SEO for Monterrey, Texas, or 'near me' searches?","acceptedAnswer":{"@type":"Answer","text":"Yes — local is our biggest strength. We optimize Google Business Profiles, local citations, and 'near me' visibility for Monterrey, Texas, and anywhere your customers search. Local SEO is where the highest-intent, highest-converting searches live for most businesses."}},{"@type":"Question","name":"Can you guarantee #1 rankings?","acceptedAnswer":{"@type":"Answer","text":"No honest SEO can — Google's ranking is theirs to decide, and anyone promising guaranteed #1 is selling snake oil. What we guarantee is white-hat work, transparency, and a strategy tied to real demand and outcomes. The best SEO company isn't the one with the biggest promise — it's the one whose own results you can verify. The proof is this site: you found it because our SEO works."}}]}]}5:["$","main",null,{"className":"mx-auto max-w-[1400px] px-6","children":[["$","script",null,{"id":"seo-schema","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$12"}}],"$L13","$L14","$L15",["$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22"],"$L23","$L24","$L25","$L26"]}]
