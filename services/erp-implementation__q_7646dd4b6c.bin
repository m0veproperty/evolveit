20:["$","section",null,{"id":"cost","data-reveal":true,"className":"scroll-mt-24 border-b-hairline-soft py-20","children":[["$","p",null,{"className":"font-mono text-label uppercase text-fg-muted [letter-spacing:var(--tracking-label)]","children":"Cost & engagement"}],["$","h2",null,{"className":"mt-4 max-w-[24ch] font-display text-display-l font-extrabold text-fg [text-wrap:balance]","children":"Scoped to your rollout — from $50 USD an hour."}],["$","p",null,{"className":"mt-8 font-mono text-body text-fg-secondary","children":"There's no flat rate — ERP cost depends on the modules, users, integrations, and data. Senior certified consulting starts at $50 USD/hour, and ongoing support runs hourly or as a fixed monthly retainer. We scope a fixed-price discovery first, so you get a predictable number before the build."}],["$","div",null,{"className":"mt-10 rounded-xl border-hairline bg-white/[0.015] p-6 sm:p-8","children":[["$","p",null,{"className":"font-mono text-label-s uppercase text-accent [letter-spacing:var(--tracking-label-tight)]","children":"Fixed-scope · built not to overrun"}],["$","p",null,{"className":"mt-3 font-mono text-body text-fg-secondary","children":"Most ERP overruns come from scope creep. We lock scope in discovery and use AI to speed config, data migration, and testing — a predictable number and a faster go-live."}]]}],["$","ul",null,{"data-reveal-stagger":true,"className":"mt-8 grid grid-cols-1 gap-4 sm:grid-cols-3","children":[["$","li","Implementation project",{"className":"flex flex-col rounded-xl border-hairline bg-white/[0.015] p-6","children":[["$","span",null,{"className":"font-mono text-label-s uppercase text-fg-muted [letter-spacing:var(--tracking-label-tight)]","children":"Fixed scope · milestones"}],["$","h3",null,{"className":"mt-3 font-display text-display-s font-bold text-fg","children":"Implementation project"}],["$","p",null,{"className":"mt-2 font-mono text-body-sm text-fg-secondary","children":"Sized to your modules and data — scoped and priced up front, billed against go-live milestones."}]]}],["$","li","Hourly consulting",{"className":"flex flex-col rounded-xl border-hairline bg-white/[0.015] p-6","children":[["$","span",null,{"className":"font-mono text-label-s uppercase text-fg-muted [letter-spacing:var(--tracking-label-tight)]","children":"Per hour · from $50 USD"}],["$","h3",null,{"className":"mt-3 font-display text-display-s font-bold text-fg","children":"Hourly consulting"}],["$","p",null,{"className":"mt-2 font-mono text-body-sm text-fg-secondary","children":"Senior ERP consultant time when you need it — config tweaks, integrations, or a focused phase."}]]}],["$","li","Support retainer",{"className":"flex flex-col rounded-xl border-hairline bg-white/[0.015] p-6","children":[["$","span",null,{"className":"font-mono text-label-s uppercase text-fg-muted [letter-spacing:var(--tracking-label-tight)]","children":"Monthly retainer"}],["$","h3",null,{"className":"mt-3 font-display text-display-s font-bold text-fg","children":"Support retainer"}],["$","p",null,{"className":"mt-2 font-mono text-body-sm text-fg-secondary","children":"Ongoing support, training, and optimization after go-live, as a fixed monthly rate."}]]}]]}]]}]
