11:["$","$L43",null,{"formats":"$undefined","locale":"en","messages":{"cookies":{"aria":"Cookie consent","body":"Without data, we're guessing. With analytics and marketing cookies we know what helps you and what doesn't. You can change your mind anytime.","accept":"Accept","reject":"Reject","privacyLink":"Privacy policy"},"consent":{"aria":"Accept the privacy policy","pre":"I accept the ","privacyLink":"privacy policy","post":" and to be contacted by WeEvolveIT.","required":"Please accept the privacy policy to continue."},"common":{"getStarted":"Get started","contactUs":"Contact us","learnMore":"Learn more","bookACall":"Book a call","viewAll":"View all","showAll":"Show all {total} {label}","viewGrid":"Grid view","viewList":"List view"},"sitemap":{"metaTitle":"Sitemap","metaDescription":"Every page of WeEvolveIT in one place — services, case studies, blog, free tools, and more.","eyebrow":"Navigation","title":"Sitemap","lead":"Every section of the site, in one place.","secMain":"Main","secServices":"Services","secCases":"Case studies by industry","secBlog":"Blog by category","secTools":"Free tools","secLegal":"Legal","linkHome":"Home","linkBlog":"Blog","linkPrivacy":"Privacy","linkTerms":"Terms","secAllPosts":"All articles","secAllCases":"All case studies"},"aiBusinessCheck":{"metaTitle":"Business Diagnosis","metaDescription":"Free AI-first business diagnosis. Answer four quick questions and a senior consultant reviews where technology is costing your business — usually within one business day.","eyebrow":"Free · Business Diagnosis","h1":"Where is technology costing your business?","lead":"Tell us what's hurting and our AI-first diagnosis shows where your business is leaking time, money, or growth — then exactly what we'd do about it.","whatYouGet":"What you get","point1":"A senior human diagnosis — not an automated score.","point2":"The specific bottleneck named, and the fix we'd prescribe.","point3":"A reply usually within one business day. No obligation."},"nav":{