20:["$","section",null,{"id":"crm-cost","data-reveal":true,"className":"scroll-mt-24 border-b-hairline-soft py-20","children":["$undefined",["$","h2",null,{"className":"max-w-[30ch] font-display text-display-l font-extrabold text-fg [text-wrap:balance]","children":"What drives CRM implementation cost"}],["$","p",null,{"className":"mt-8 max-w-[70ch] font-mono text-body text-fg-secondary","children":"CRM implementation cost depends on the platform, the number of users, the integrations, and how messy the data is. In practice, projects fall into three scopes:"}],["$","ul",null,{"className":"mt-8 space-y-4","children":[["$","li","Small business",{"className":"flex gap-4","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[0.6em] h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","p",null,{"className":"font-mono text-body text-fg-secondary","children":[["$","span",null,{"className":"font-bold text-fg","children":"Small business"}]," — HubSpot or Zoho, one pipeline, and a light data migration."]}]]}],["$","li","Mid-market rollout",{"className":"flex gap-4","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[0.6em] h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","p",null,{"className":"font-mono text-body text-fg-secondary","children":[["$","span",null,{"className":"font-bold text-fg","children":"Mid-market rollout"}]," — HubSpot or Salesforce, multiple pipelines, and a few integrations."]}]]}],["$","li","Enterprise build",{"className":"flex gap-4","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[0.6em] h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","p",null,{"className":"font-mono text-body text-fg-secondary","children":[["$","span",null,{"className":"font-bold text-fg","children":"Enterprise build"}]," — Salesforce or Dynamics 365, with heavy customization and integrations."]}]]}]]}],["$","p",null,{"className":"mt-8 max-w-[70ch] font-mono text-body text-fg-secondary","children":"Senior nearshore consulting starts at $50 USD/hour, and we scope a fixed-price discovery first so you see a predictable number before the build. Ongoing adoption support runs hourly or as a fixed monthly retainer."}]]}]
21:["$","section",null,{"id":"crm-partner","data-reveal":true,"className":"scroll-mt-24 border-b-hairline-soft py-20","children":["$undefined",["$","h2",null,{"className":"max-w-[30ch] font-display text-display-l font-extrabold text-fg [text-wrap:balance]","children":"Your Salesforce and HubSpot implementation partner, nearshore"}],["$","p",null,{"className":"mt-8 max-w-[70ch] font-mono text-body text-fg-secondary","children":"Most Salesforce and HubSpot implementation partners bill at agency or reseller rates and get paid whichever platform you pick. We don't resell licenses, so our advice stays neutral: we recommend the CRM your team will actually adopt, then implement it end to end. Certified senior consultants work in your time zone, from Monterrey and Houston, at nearshore rates from $50 USD/hour (leaner than a US partner rate card, with full-day overlap for real-time collaboration)."}],"$undefined","$undefined"]}]
22:null
23:["$","$L3b",null,{"faqs":[{"question":"What is CRM implementation?","answer":"CRM implementation is selecting, configuring, and rolling out a customer relationship management platform — like Salesforce, HubSpot, or Microsoft Dynamics — then migrating your data and getting your team to use it. It puts sales, marketing, and customer service on one system instead of scattered spreadsheets and inboxes."},{"question":"How do you implement a CRM system?","answer":"We run it in phases: discovery and planning, vendor selection, configuration around your sales process, data cleanup and migration, integrations, testing, training and adoption, go-live, and ongoing optimization. The emphasis is adoption — a CRM only pays back when the team actually uses it."},{"question":"Why do CRM implementations fail?","answer":"The number-one reason is adoption: the sales team won't use it, so the data rots. Other causes are over-customization, dirty data, a CRM that doesn't fit the sales motion, a wrong-fit vendor, and set-and-forget launches. We de-risk each — adoption-first design, configure-over-customize, clean data, process-fit, vendor-by-fit, and ongoing optimization."},{"question":"How much does CRM implementation cost?","answer":"It depends on the platform, the number of users, integrations, and data complexity. Senior consulting starts at $50 USD/hour, and we scope a fixed-price discovery first so you get a predictable number before the build. Ongoing adoption support runs hourly or as a fixed monthly retainer."},{"question":"Salesforce, HubSpot, or Zoho — which CRM should we choose?","answer":"As a rule of thumb: Salesforce fits complex, enterprise sales teams that need deep customization; HubSpot fits mid-market teams that want fast adoption and marketing built in; Zoho fits budget-conscious SMBs; Dynamics 365 fits companies already on the Microsoft stack. We're vendor-neutral — we assess fit across the major platforms and recommend the one your team will actually adopt."},{"question":"Can you add AI to our CRM?","answer":"Yes. We connect AI agents over your CRM data — for lead scoring, automated follow-ups, quoting, and sales automation — so the CRM does more of the work and your reps spend more time selling. This works on top of your existing CRM."},{"question":"What does a CRM implementation consultant do?","answer":"A CRM implementation consultant selects the right platform for your sales motion, configures pipelines and automations, cleans and migrates your data, integrates the CRM with your stack, and trains the team until it's actually adopted. At WeEvolveIT, a senior nearshore implementation team runs that end to end — as your implementation partner, not a reseller."},{"question":"Are you a Salesforce implementation partner?","answer":"Yes. We implement Salesforce end to end (configuration, data migration, integrations, and adoption training) as your hands-on implementation partner, not a reseller. Our senior nearshore consultants are certified across Sales Cloud and Service Cloud, and because we're vendor-neutral, we'll tell you honestly if Salesforce isn't the right fit for how your team sells."},{"question":"Do you work as a HubSpot implementation partner?","answer":"Yes. We implement HubSpot across the Sales, Marketing, and Service Hubs (setup, data migration, workflow automation, and adoption training) as your implementation partner. HubSpot is often the fastest CRM to get a team actually using, which is why we recommend it for mid-market teams that want sales and marketing on one platform."},{"question":"How long does a CRM implementation take?","answer":"Most CRM implementations take 4 to 12 weeks, depending on the platform, the number of users, the integrations, and how much data needs cleaning and migrating. A focused HubSpot or Zoho rollout can go live in weeks; a complex Salesforce or Dynamics build with multiple integrations takes longer. We scope the timeline in a fixed-price discovery before any build starts."}],"id":"faq","title":"What teams ask before a CRM project.","fill":true}]
