20:["$","section",null,{"id":"cost","data-reveal":true,"className":"scroll-mt-24 border-b-hairline-soft py-20","children":[["$","p",null,{"className":"font-mono text-label uppercase text-fg-muted [letter-spacing:var(--tracking-label)]","children":"Cost & engagement"}],["$","h2",null,{"className":"mt-4 max-w-[26ch] font-display text-display-l font-extrabold text-fg [text-wrap:balance]","children":"From a cross-platform MVP to a full product — senior, nearshore."}],["$","p",null,{"className":"mt-8 font-mono text-body text-fg-secondary","children":"Mobile app development cost depends on scope. Most custom apps run from about $30K for a focused MVP to $250K+ for a complex, multi-feature product — driven by screens, integrations, and platforms. Cross-platform usually cuts the cost of covering both stores roughly in half. We scope a fixed number after a discovery. Hire senior nearshore mobile app developers from $50/hr and keep it a fraction of a US agency."}],"$undefined",["$","ul",null,{"data-reveal-stagger":true,"className":"mt-8 grid grid-cols-1 gap-4 sm:grid-cols-3","children":[["$","li","App MVP",{"className":"flex flex-col rounded-xl border p-6 border-accent/30 bg-accent/[0.03]","children":[["$","span",null,{"className":"font-mono text-label-s uppercase [letter-spacing:var(--tracking-label-tight)] text-accent","children":"Fixed scope · from ~$30K"}],["$","h3",null,{"className":"mt-3 font-display text-display-s font-bold text-fg","children":"App MVP"}],["$","p",null,{"className":"mt-2 font-mono text-body-sm text-fg-secondary","children":"A focused first version — designed, built cross-platform, and shipped to both stores."}]]}],["$","li","Full product",{"className":"flex flex-col rounded-xl border p-6 border-hairline bg-white/[0.015]","children":[["$","span",null,{"className":"font-mono text-label-s uppercase [letter-spacing:var(--tracking-label-tight)] text-fg-muted","children":"Multi-feature · custom"}],["$","h3",null,{"className":"mt-3 font-display text-display-s font-bold text-fg","children":"Full product"}],["$","p",null,{"className":"mt-2 font-mono text-body-sm text-fg-secondary","children":"A complete app with backend, integrations, and the roadmap to grow it."}]]}],["$","li","App + maintenance",{"className":"flex flex-col rounded-xl border p-6 border-hairline bg-white/[0.015]","children":[["$","span",null,{"className":"font-mono text-label-s uppercase [letter-spacing:var(--tracking-label-tight)] text-fg-muted","children":"Build + retainer"}],["$","h3",null,{"className":"mt-3 font-display text-display-s font-bold text-fg","children":"App + maintenance"}],["$","p",null,{"className":"mt-2 font-mono text-body-sm text-fg-secondary","children":"We build it and keep it alive — OS updates, fixes, and new features over time."}]]}]]}]]}]
21:["$","section",null,{"id":"app-pricing","data-reveal":true,"className":"scroll-mt-24 border-b-hairline-soft py-20","children":["$undefined",["$","h2",null,{"className":"max-w-[30ch] font-display text-display-l font-extrabold text-fg [text-wrap:balance]","children":"Mobile app development services, scoped and quoted up front"}],["$","p",null,{"className":"mt-8 max-w-[70ch] font-mono text-body text-fg-secondary","children":"Our mobile app development services are scoped and priced before we start, so there's no open-ended meter."}],["$","ul",null,{"className":"mt-8 space-y-4","children":[["$","li","Cross-platform MVP",{"className":"flex gap-4","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[0.6em] h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","p",null,{"className":"font-mono text-body text-fg-secondary","children":[["$","span",null,{"className":"font-bold text-fg","children":"Cross-platform MVP"}]," — one React Native or Flutter codebase shipped to both stores."]}]]}],["$","li","Full multi-feature product",{"className":"flex gap-4","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[0.6em] h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","p",null,{"className":"font-mono text-body text-fg-secondary","children":[["$","span",null,{"className":"font-bold text-fg","children":"Full multi-feature product"}]," — backend, integrations, and a growth roadmap."]}]]}],["$","li","App plus maintenance",{"className":"flex gap-4","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[0.6em] h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","p",null,{"className":"font-mono text-body text-fg-secondary","children":[["$","span",null,{"className":"font-bold text-fg","children":"App plus maintenance"}]," — the build plus a monthly retainer for OS updates, fixes, and new features."]}]]}],["$","li","Senior nearshore app developers",{"className":"flex gap-4","children":[["$","span",null,{"aria-hidden":true,"className":"mt-[0.6em] h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","p",null,{"className":"font-mono text-body text-fg-secondary","children":[["$","span",null,{"className":"font-bold text-fg","children":"Senior nearshore app developers"}]," — from a set hourly rate, in US time zones, a fraction of a US agency."]}]]}]]}],["$","p",null,{"className":"mt-8 max-w-[70ch] font-mono text-body text-fg-secondary","children":"Cross-platform usually cuts the cost of covering both iOS and Android roughly in half, because you build once instead of twice."}]]}]
22:["$","section",null,{"id":"cross-platform-company","data-reveal":true,"className":"scroll-mt-24 border-b-hairline-soft py-20","children":["$undefined",["$","h2",null,{"className":"max-w-[30ch] font-display text-display-l font-extrabold text-fg [text-wrap:balance]","children":"A cross-platform app development company, nearshore"}],["$","p",null,{"className":"mt-8 max-w-[70ch] font-mono text-body text-fg-secondary","children":"As a cross-platform app development company, we default to one React Native or Flutter codebase that ships to both the App Store and Google Play, so you cover iOS and Android for roughly half the cost of two native builds. What separates us from most cross-platform app development companies is what happens after launch: we're nearshore in US time zones, we hand you the codebase and the store accounts, and we maintain the app through every OS update instead of walking away at handoff. That's how a mobile app should be built: once, cleanly, and kept alive."}],"$undefined","$undefined"]}]
