10:T999,{"@context":"https://schema.org","@graph":[{"@id":"https://weevolveit.com#organization","@type":"Organization","name":"WeEvolveIT","alternateName":["We Evolve IT","We EvolveIT","WeEvolve IT","We Evolve","Evolve IT"],"url":"https://weevolveit.com","logo":"https://weevolveit.com/brand/logo-weevolveit-dark.svg","sameAs":["https://www.linkedin.com/company/weevolveit","https://www.instagram.com/weevolveit","https://www.facebook.com/weevolveit","https://www.tiktok.com/@weevolveit"],"foundingDate":"2010","founders":[],"address":{"@type":"PostalAddress","streetAddress":"Venustiano Carranza 601","addressLocality":"Monterrey","addressRegion":"Nuevo León","postalCode":"64710","addressCountry":"MX"},"areaServed":[{"@type":"Country","name":"Mexico"},{"@type":"Country","name":"United States"},{"@type":"Country","name":"United Arab Emirates"}]},{"@type":"WebSite","@id":"https://weevolveit.com#website","url":"https://weevolveit.com","name":"WeEvolveIT","publisher":{"@id":"https://weevolveit.com#organization"}},{"@type":"ProfessionalService","@id":"https://weevolveit.com#local-business","name":"WeEvolveIT","description":"AI specialists. A five-phase method — Discover, Diagnose, Design, Deliver, Evolve — that transforms how your business runs on technology. HQ Monterrey, presence in Dubai, 17 countries served.","url":"https://weevolveit.com","logo":"https://weevolveit.com/brand/logo-weevolveit-dark.svg","image":"https://weevolveit.com/opengraph-image.jpg","address":{"@type":"PostalAddress","streetAddress":"Venustiano Carranza 601","addressLocality":"Monterrey","addressRegion":"Nuevo León","postalCode":"64710","addressCountry":"MX"},"areaServed":[{"@type":"Country","name":"Mexico"},{"@type":"Country","name":"United States"},{"@type":"Country","name":"United Arab Emirates"}],"sameAs":["https://www.linkedin.com/company/weevolveit","https://www.instagram.com/weevolveit","https://www.facebook.com/weevolveit","https://www.tiktok.com/@weevolveit"],"foundingDate":"2010","priceRange":"$$","knowsLanguage":["es-MX","en-US"],"slogan":"your tech partner. evolved.","contactPoint":{"@type":"ContactPoint","contactType":"sales","url":"https://wa.me/19562721609?text=Hola%20WeEvolveIT%20%F0%9F%91%8B%20vi%20su%20sitio%20y%20me%20interesa%20su%20servicio%2C%20me%20gustar%C3%ADa%20platicar%20de%20mi%20proyecto.","availableLanguage":["Spanish","English"],"areaServed":["MX","US"]},"parentOrganization":{"@id":"https://weevolveit.com#organization"}}]}4:["$","html",null,{"lang":"en","className":"geist_mono_1bf8cbf6-module__FlyLvG__variable jetbrains_mono_84d6efd-module__5Hl15a__variable h-full antialiased","suppressHydrationWarning":true,"children":[["$","head",null,{"children":[["$","link",null,{"rel":"preconnect","href":"https://www.googletagmanager.com","crossOrigin":"anonymous"}],["$","link",null,{"rel":"preconnect","href":"https://ipapi.co","crossOrigin":"anonymous"}],["$","link",null,{"rel":"dns-prefetch","href":"https://www.googletagmanager.com"}],["$","link",null,{"rel":"dns-prefetch","href":"https://ipapi.co"}],["$","script",null,{"dangerouslySetInnerHTML":{"__html":"try {\n  if ('scrollRestoration' in history) history.scrollRestoration = 'manual';\n  window.scrollTo(0, 0);\n  var seenIntro = false;\n  try { seenIntro = !!sessionStorage.getItem('we_intro_seen'); } catch (e) {}\n  if (seenIntro || window.matchMedia('(prefers-reduced-motion: reduce)').matches || window.matchMedia('(max-width: 767px)').matches) {\n    document.documentElement.classList.add('intro-skip');\n  }\n} catch (e) {}"}}]]}],["$","body",null,{"className":"isolate min-h-full flex flex-col overflow-x-clip bg-bg text-fg font-mono","suppressHydrationWarning":true,"children":[["$","script",null,{"id":"site-schema","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11"]}]]}]
12:T1bf0,{"@context":"https://schema.org","@graph":[{"@type":"WebSite","@id":"https://weevolveit.com#website","url":"https://weevolveit.com","name":"WeEvolveIT","publisher":{"@id":"https://weevolveit.com#organization"}},{"@id":"https://weevolveit.com#organization","@type":"Organization","name":"WeEvolveIT","alternateName":["We Evolve IT","We EvolveIT","WeEvolve IT","We Evolve","Evolve IT"],"url":"https://weevolveit.com","logo":"https://weevolveit.com/brand/logo-weevolveit-dark.svg","sameAs":["https://www.linkedin.com/company/weevolveit","https://www.instagram.com/weevolveit","https://www.facebook.com/weevolveit","https://www.tiktok.com/@weevolveit"],"foundingDate":"2010","founders":[],"address":{"@type":"PostalAddress","streetAddress":"Venustiano Carranza 601","addressLocality":"Monterrey","addressRegion":"Nuevo León","postalCode":"64710","addressCountry":"MX"},"areaServed":[{"@type":"Country","name":"Mexico"},{"@type":"Country","name":"United States"},{"@type":"Country","name":"United Arab Emirates"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://weevolveit.com/"},{"@type":"ListItem","position":2,"name":"Services","item":"https://weevolveit.com/services"},{"@type":"ListItem","position":3,"name":"Cloud Migration Services","item":"https://weevolveit.com/services/cloud-migration"}]},{"@type":"Service","@id":"https://weevolveit.com/services/cloud-migration#service","name":"Cloud Migration Services","description":"Cloud migration is moving your applications, data, and infrastructure from on-premise servers — or one cloud to another — onto a platform like AWS, Azure, or Google Cloud, re-platforming or re-architecting them to run faster, scale on demand, and cost less to operate.","serviceType":"Cloud Migration & DevOps","provider":{"@id":"https://weevolveit.com#organization"},"url":"https://weevolveit.com/services/cloud-migration","areaServed":[{"@type":"Country","name":"Mexico"},{"@type":"Country","name":"United States"},{"@type":"Country","name":"United Arab Emirates"}],"offers":{"@type":"Offer","priceCurrency":"USD","availability":"https://schema.org/InStock","url":"https://weevolveit.com/services/cloud-migration#contact"}},{"@type":"HowTo","name":"How we run a cloud migration","step":[{"@type":"HowToStep","position":1,"name":"Discover","text":"We map your workloads, dependencies, and the dollar value of moving each — a fixed-scope assessment, so you see the migration plan and the cost before committing."},{"@type":"HowToStep","position":2,"name":"Diagnose","text":"We assess your current infrastructure, the cloud-readiness of each app, and where the biggest cost and performance wins are."},{"@type":"HowToStep","position":3,"name":"Design","text":"We design the target architecture — the right cloud, the right managed services, the migration approach per workload, and the DevOps pipeline."},{"@type":"HowToStep","position":4,"name":"Deliver","text":"We migrate in waves with zero-downtime cutovers, stand up CI/CD and infrastructure as code, and validate every workload against milestones."},{"@type":"HowToStep","position":5,"name":"Evolve","text":"Continuous improvement. We keep optimizing cost (FinOps), tightening security, and adopting new cloud capabilities — your platform stays current and lean, without you standing up a full cloud team in-house."}]},{"@type":"CollectionPage","@id":"https://weevolveit.com/services/cloud-migration#page","url":"https://weevolveit.com/services/cloud-migration","name":"Cloud Migration Services | WeEvolveIT","description":"Cloud migration is moving your applications, data, and infrastructure from on-premise servers — or one cloud to another — onto a platform like AWS, Azure, or Google Cloud, re-platforming or re-architecting them to run faster, scale on demand, and cost less to operate.","isPartOf":{"@id":"https://weevolveit.com#website"},"about":{"@type":"Service","name":"Cloud Migration Services"}},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is cloud migration?","acceptedAnswer":{"@type":"Answer","text":"Cloud migration is moving your applications, data, and infrastructure from on-premise servers — or from one cloud to another — onto a cloud platform like AWS, Azure, or Google Cloud. Depending on the workload, you rehost it as-is, replatform it with targeted upgrades, or refactor it to run cloud-native."}},{"@type":"Question","name":"What are the main challenges of cloud migration?","acceptedAnswer":{"@type":"Answer","text":"The usual ones: hidden dependencies between systems, surprise costs after go-live, downtime risk during cutover, data security and compliance, and skills gaps in the in-house team. We de-risk each with a fixed-scope assessment, dependency mapping, waved cutovers, and FinOps from day one."}},{"@type":"Question","name":"How long does a cloud migration take?","acceptedAnswer":{"@type":"Answer","text":"It depends on the number and complexity of workloads. A single app can move in weeks; a full datacenter exit runs months, in waves. We scope it in the discovery phase so you get a realistic timeline and cost before any migration starts."}},{"@type":"Question","name":"How much does cloud migration cost?","acceptedAnswer":{"@type":"Answer","text":"Engineering starts at $50 USD/hour with senior certified talent, and the engagement is scoped up front. Just as important is what migration saves: right-sizing and FinOps frequently cut the ongoing cloud bill enough to offset the project cost."}},{"@type":"Question","name":"AWS, Azure, or Google Cloud — which should we choose?","acceptedAnswer":{"@type":"Answer","text":"It depends on your stack, your team's skills, and your workloads — not on who we resell (we're vendor-neutral). We assess fit across all three and recommend the platform, or mix, that costs less and runs better for your case."}},{"@type":"Question","name":"Will there be downtime during migration?","acceptedAnswer":{"@type":"Answer","text":"We plan for zero-downtime cutovers wherever possible — migrating in waves, running old and new in parallel, and switching over with validated rollback plans. Any unavoidable maintenance window is scheduled and minimized."}},{"@type":"Question","name":"What are the steps in a cloud migration strategy?","acceptedAnswer":{"@type":"Answer","text":"A proven cloud migration strategy runs in five steps: 1) assess your on-premise infrastructure, costs, and dependencies; 2) plan the approach per workload (the 7 Rs) and the target architecture; 3) migrate in waves with zero-downtime cutovers; 4) optimize cost with FinOps; 5) operate and keep improving. We scope steps 1–2 as a fixed-price assessment."}},{"@type":"Question","name":"What are the 7 Rs of cloud migration?","acceptedAnswer":{"@type":"Answer","text":"The 7 Rs are the standard options for each workload in a migration: rehost (lift-and-shift), replatform (lift-and-optimize), refactor (rebuild cloud-native), repurchase (move to SaaS), relocate (move as-is at the hypervisor level), retire (shut it down), and retain (leave it where it is — for now). Most portfolios mix several."}}]}]}5:["$","main",null,{"className":"mx-auto max-w-[1400px] px-6","children":[["$","script",null,{"id":"cloud-migration-schema","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$12"}}],"$L13","$L14","$L15",["$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f"],"$L20","$L21","$L22","$L23"]}]
