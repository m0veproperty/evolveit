16:["$","section",null,{"id":"what-is","data-reveal":true,"className":"scroll-mt-24 border-b-hairline-soft py-20","children":[["$","div",null,{"className":"grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16","children":[["$","div",null,{"children":[["$","h2",null,{"className":"max-w-[22ch] font-display text-display-l font-extrabold text-fg [text-wrap:balance]","children":"What is data analytics?"}],["$","p",null,{"className":"mt-8 font-mono text-body text-fg-secondary","children":"Data analytics is the work of turning your business data into decisions — collecting and cleaning it (data engineering), modeling it in a warehouse, surfacing it in BI dashboards, and predicting with it using AI. It's a service, not a course: we build the pipelines, the dashboards, and the AI agents that tell you what's happening, why, and what to do next."}]]}],["$","figure",null,{"className":"relative aspect-[4/3] overflow-hidden rounded-2xl border-hairline","children":["$","$L31",null,{"src":"/images/services/data-analytics/what-is.webp","alt":"The data analytics maturity ladder: raw data flows through engineering pipelines into a BI dashboard and up to a single highlighted business decision","fill":true,"sizes":"(max-width:1024px) 100vw, 50vw","className":"object-cover"}]}]]}],["$","dl",null,{"className":"mt-12 grid grid-cols-1 gap-4 md:grid-cols-2","children":[["$","div","Data analytics vs BI vs data science?",{"className":"rounded-xl border-hairline bg-white/[0.015] p-6","children":[["$","dt",null,{"className":"font-display text-display-s font-bold text-fg","children":"Data analytics vs BI vs data science?"}],["$","dd",null,{"className":"mt-3 font-mono text-body text-fg-secondary","children":"Business intelligence (BI) shows you what happened — dashboards and reports. Data analytics digs into why and what's next. Data science builds predictive models and AI. They're a ladder, not rivals — and we do all three, end to end."}]]}],["$","div","Do I own my data and stack?",{"className":"rounded-xl border-hairline bg-white/[0.015] p-6","children":[["$","dt",null,{"className":"font-display text-display-s font-bold text-fg","children":"Do I own my data and stack?"}],["$","dd",null,{"className":"mt-3 font-mono text-body text-fg-secondary","children":"Yes — always. Your warehouse, pipelines, dashboards, and models are yours. We build on your cloud (or set one up for you), with no lock-in to a black-box platform."}]]}]]}]]}]
