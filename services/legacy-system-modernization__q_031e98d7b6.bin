1b:["$","section",null,{"id":"modernize-flow","data-reveal":true,"className":"scroll-mt-24 border-b-hairline-soft py-20","children":["$","div",null,{"className":"grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16","children":[["$","div",null,{"children":[["$","p",null,{"className":"font-mono text-label uppercase text-accent [letter-spacing:var(--tracking-label)]","children":"How we modernize"}],["$","h2",null,{"className":"mt-4 max-w-[24ch] font-display text-display-l font-extrabold text-fg [text-wrap:balance]","children":"From legacy to modern — without the big-bang."}],"$undefined",["$","p",null,{"className":"mt-8 font-mono text-body text-fg-secondary","children":"We don't rip and replace. We assess the legacy system, choose the right approach (the 7 R's), modernize piece by piece, integrate old and new while data migrates safely, then retire the legacy and keep the new system current."}],"$undefined"]}],["$","$L33",null,{"steps":[{"img":"01-assess","label":"Assess","caption":"We audit the legacy system, the risks, and the dependencies."},{"img":"02-approach","label":"Choose the approach","caption":"The 7 R's — rehost, refactor, or rebuild, by fit."},{"img":"03-modernize","label":"Modernize incrementally","caption":"No big-bang — we modernize piece by piece."},{"img":"04-integrate","label":"Integrate & migrate","caption":"We connect old and new and migrate data safely."},{"img":"05-evolve","label":"Decommission & evolve","caption":"We retire the legacy and keep the new system current."}],"basePath":"/images/services/legacy-system-modernization/build-flow"}]]}]}]
