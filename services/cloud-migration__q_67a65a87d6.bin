16:["$","section",null,{"id":"what-is","data-reveal":true,"className":"scroll-mt-24 border-b-hairline-soft py-20","children":[["$","div",null,{"className":"grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16","children":[["$","div",null,{"children":[["$","h2",null,{"className":"max-w-[20ch] font-display text-display-l font-extrabold text-fg [text-wrap:balance]","children":"What is cloud migration?"}],["$","p",null,{"className":"mt-8 font-mono text-body text-fg-secondary","children":"Cloud migration is moving your applications, data, and infrastructure from on-premise servers — or one cloud to another — onto a platform like AWS, Azure, or Google Cloud, re-platforming or re-architecting them to run faster, scale on demand, and cost less to operate."}]]}],["$","figure",null,{"className":"relative aspect-[4/3] overflow-hidden rounded-2xl","children":["$","$L30",null,{"src":"/images/services/cloud/what-is.webp","alt":"A cloud engineer mapping services and databases to the cloud across an infrastructure console and an architecture diagram","fill":true,"sizes":"(max-width: 1024px) 100vw, 50vw","className":"object-cover"}]}]]}],["$","dl",null,{"className":"mt-12 grid grid-cols-1 gap-4 md:grid-cols-2","children":[["$","div","Cloud migration vs. cloud-native — what's the difference?",{"className":"rounded-xl border-hairline bg-white/[0.015] p-6","children":[["$","dt",null,{"className":"font-display text-display-s font-bold text-fg","children":"Cloud migration vs. cloud-native — what's the difference?"}],["$","dd",null,{"className":"mt-3 font-mono text-body text-fg-secondary","children":"Migration is moving an existing system onto the cloud (rehost or replatform). Cloud-native means building (or rebuilding) it to use cloud services directly — serverless, managed databases, autoscaling. Migration gets you there; cloud-native is how much you modernize on the way."}]]}],["$","div","Lift-and-shift vs. re-architecting?",{"className":"rounded-xl border-hairline bg-white/[0.015] p-6","children":[["$","dt",null,{"className":"font-display text-display-s font-bold text-fg","children":"Lift-and-shift vs. re-architecting?"}],["$","dd",null,{"className":"mt-3 font-mono text-body text-fg-secondary","children":"Lift-and-shift (rehost) moves your app as-is — fastest, lowest risk, fewer cloud gains. Re-architecting rebuilds it cloud-native — slower and costlier up front, but maximum scalability and the lowest run cost. Most workloads land in the middle: replatform."}]]}]]}]]}]
