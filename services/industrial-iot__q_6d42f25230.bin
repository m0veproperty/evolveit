21:["$","section",null,{"id":"cost","data-reveal":true,"className":"scroll-mt-24 border-b-hairline-soft py-20","children":[["$","p",null,{"className":"font-mono text-label uppercase text-fg-muted [letter-spacing:var(--tracking-label)]","children":"Cost & engagement"}],["$","h2",null,{"className":"mt-4 max-w-[26ch] font-display text-display-l font-extrabold text-fg [text-wrap:balance]","children":"From AI agents to full builds — senior, from $50 USD an hour."}],["$","p",null,{"className":"mt-8 font-mono text-body text-fg-secondary","children":"Cost depends on your machines and scope. We work three ways: Agentic Operations as a monthly productized service, a fixed-scope project priced up front after discovery, or a dedicated nearshore IoT team from $50 USD/hour. Senior nearshore talent costs a fraction of an OEM engagement — and you own every connector, dashboard, and model we build."}],"$undefined",["$","ul",null,{"data-reveal-stagger":true,"className":"mt-8 grid grid-cols-1 gap-4 sm:grid-cols-3","children":[["$","li","Agentic Operations",{"className":"flex flex-col rounded-xl border p-6 border-accent/30 bg-accent/[0.03]","children":[["$","span",null,{"className":"font-mono text-label-s uppercase [letter-spacing:var(--tracking-label-tight)] text-accent","children":"Monthly · productized"}],["$","h3",null,{"className":"mt-3 font-display text-display-s font-bold text-fg","children":"Agentic Operations"}],["$","p",null,{"className":"mt-2 font-mono text-body-sm text-fg-secondary","children":"AI agents connected to your factory data, monitoring lines and predicting failures — reports and alerts on demand or on a schedule, under your umbrella."}]]}],["$","li","IIoT project",{"className":"flex flex-col rounded-xl border p-6 border-hairline bg-white/[0.015]","children":[["$","span",null,{"className":"font-mono text-label-s uppercase [letter-spacing:var(--tracking-label-tight)] text-fg-muted","children":"Per project · costed up front"}],["$","h3",null,{"className":"mt-3 font-