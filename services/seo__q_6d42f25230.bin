16:["$","section",null,{"id":"what-is","data-reveal":true,"className":"scroll-mt-24 border-b-hairline-soft py-20","children":[["$","div",null,{"className":"grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16","children":[["$","div",null,{"children":[["$","h2",null,{"className":"max-w-[20ch] font-display text-display-l font-extrabold text-fg [text-wrap:balance]","children":"What are SEO services?"}],["$","p",null,{"className":"mt-8 font-mono text-body text-fg-secondary","children":"SEO (search engine optimization) is the work of earning organic visibility in search — technical health, content, and authority that move your pages up Google — and, increasingly, GEO and AEO: getting your business cited by ChatGPT, Perplexity, and Google's AI answers. The goal is qualified traffic that compounds over time, without paying per click."}]]}],["$","figure",null,{"className":"relative aspect-[4/3] overflow-hidden rounded-2xl border-hairline","children":["$","$L33",null,{"src":"/images/services/seo/involves/ranking.webp","alt":"Search ranking positions climbing toward the #1 spot on Google","fill":true,"sizes":"(max-width:1024px) 100vw, 50vw","className":"object-cover"}]}]]}],["$","dl",null,{"className":"mt-12 grid grid-cols-1 gap-4 md:grid-cols-2","children":[["$","div","SEO vs. paid ads (PPC)?",{"className":"rounded-xl border-hairline bg-white/[0.015] p-6","children":[["$","dt",null,{"className":"font-display text-display-s font-bold text-fg","children":"SEO vs. paid ads (PPC)?"}],["$","dd",null,{"className":"mt-3 font-mono text-body text-fg-secondary","children":"SEO earns organic rankings over time — no per-click cost, and it keeps working after you stop. PPC buys instant visibility with ads that stop the moment the budget does. SEO compounds; ads don't. Most businesses need both, in the right mix."}]]}],["$","div","What's GEO / AEO, and why does SEO need it now?",{"className":"rounded-xl border-hairline bg-white/[0.015] p-6","children":[["$","dt",null,{"className":"font-display text-display-s font-bold text-fg","children":"What's GEO / AEO, and why does SEO need it now?"}],["$","dd",null,{"className":"mt-3 font-mono text-body text-fg-secondary","children":"SEO is no longer just Google. GEO (generative engine optimization) and AEO (answer engine optimization) get your business cited by ChatGPT, Perplexity, and Google's AI answers. As search shifts to AI, ranking #1 isn't enough — you also have to be the answer the AI gives."}]]}]]}]]}]
