16:["$","section",null,{"id":"what-is","data-reveal":true,"className":"scroll-mt-24 border-b-hairline-soft py-20","children":[["$","div",null,{"className":"grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16","children":[["$","div",null,{"children":[["$","h2",null,{"className":"max-w-[20ch] font-display text-display-l font-extrabold text-fg [text-wrap:balance]","children":"What is legacy system modernization?"}],["$","p",null,{"className":"mt-8 font-mono text-body text-fg-secondary","children":"Legacy system modernization is updating outdated software, platforms, and infrastructure — from mainframes and old codebases to unsupported applications — into modern, maintainable systems, so the business runs faster, integrates with anything, costs less to maintain, and stops depending on technology (and people) that are aging out."}]]}],["$","figure",null,{"className":"relative aspect-[4/3] overflow-hidden rounded-2xl","children":["$","$L31",null,{"src":"/images/services/legacy-system-modernization/what-is.webp","alt":"A modernization map — a legacy monolith wrapped in APIs and connected to modern cloud services and apps","fill":true,"sizes":"(max-width: 1024px) 100vw, 50vw","className":"object-cover"}]}]]}],["$","dl",null,{"className":"mt-12 grid grid-cols-1 gap-4 md:grid-cols-2","children":[["$","div","Modernize vs. rebuild from scratch?",{"className":"rounded-xl border-hairline bg-white/[0.015] p-6","children":[["$","dt",null,{"className":"font-display text-display-s font-bold text-fg","children":"Modernize vs. rebuild from scratch?"}],["$","dd",null,{"className":"mt-3 font-mono text-body text-fg-secondary","children":"Rebuilding from scratch is slow, expensive, and risky — and you lose years of business logic baked into the old system. Modernization keeps what works and updates the rest incrementally. We rebuild only the parts that earn it."}]]}],["$","div","How do you integrate legacy with modern platforms?",{"className":"rounded-xl border-hairline bg-white/[0.015] p-6","children":[["$","dt",null,{"className":"font-display text-display-s font-bold text-fg","children":"How do you integrate legacy with modern platforms?"}],["$","dd",null,{"className":"mt-3 font-mono text-body text-fg-secondary","children":"We wrap the legacy system in APIs so modern apps, cloud, and AI can talk to it — then modernize behind that boundary, piece by piece. The business keeps running while the old system retires gradually."}]]}]]}]]}]
