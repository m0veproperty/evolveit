10:T413,{"@context":"https://schema.org","@graph":[{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is \"We Evolve IT\" the same as WeEvolveIT?","acceptedAnswer":{"@type":"Answer","text":"Yes. WeEvolveIT — also written We Evolve IT, We EvolveIT, WeEvolve IT, or simply We Evolve — is one company: the technology consultancy formerly known as Kainos MX. Whatever spelling you searched, you found the right place."}},{"@type":"Question","name":"What does WeEvolveIT do?","acceptedAnswer":{"@type":"Answer","text":"WeEvolveIT is an AI-first technology consultancy — a business doctor for technology. We run every engagement through five phases (Discover, Diagnose, Design, Deliver, Evolve), from custom software and AI agents to data, cloud, and growth (SEO, GEO, AEO). 1,000+ projects across 17 countries since 2010."}},{"@type":"Question","name":"Where is WeEvolveIT based?","acceptedAnswer":{"@type":"Answer","text":"Headquartered in Monterrey, México, with presence in Houston and Dubai, serving clients across 17 countries."}}]}]}5:["$","main",null,{"className":"mx-auto max-w-[1000px] px-6 pt-36 pb-28","children":[["$","script",null,{"id":"about-faq-schema","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],["$","$L11",null,{}],["$","section",null,{"className":"text-center","children":[["$","div",null,{"className":"flex flex-wrap items-center justify-center gap-3","children":[["$","p",null,{"className":"font-mono text-label uppercase text-accent [letter-spacing:var(--tracking-label)]","children":"About"}],["$","span",null,{"className":"rounded-full border-hairline px-3 py-1 font-mono text-label-s uppercase text-fg-muted [letter-spacing:var(--tracking-label-tight)]","children":"Formerly Kainos MX"}]]}],["$","h1",null,{"className":"mx-auto mt-7 max-w-[20ch] font-display text-display-xl font-extrabold text-fg [text-wrap:balance]","children":"Always evolving. Never obsolete."}],["$","p",null,{"className":"mx-auto mt-8 max-w-[62ch] font-mono text-body text-fg-secondary [text-wrap:pretty]","children":"Technology never sits still — so neither do we. For 15+ years we've helped businesses run better on tech, reinventing how we work with every project, so what we build never falls behind."}]]}],["$","section",null,{"data-reveal":true,"className":"mt-24","children":[["$","div",null,{"className":"flex items-center gap-3","children":[["$","$L12",null,{}],["$","h2",null,{"className":"font-mono text-label uppercase text-fg-muted [letter-spacing:var(--tracking-label)]","children":"Our story"}]]}],["$","div",null,{"className":"mt-10 grid gap-10 md:grid-cols-[0.9fr_1.1fr]","children":[["$","div",null,{"children":[["$","h3",null,{"className":"font-display text-display-m font-bold text-fg [text-wrap:balance]","children":"It started with a single website."}],["$","figure",null,{"className":"relative mt-8 flex aspect-[5/3] max-w-[380px] items-center justify-center overflow-hidden rounded-2xl border-hairline bg-white/[0.02] p-8 sm:p-10","children":[["$","span",null,{"className":"absolute left-5 top-5 font-mono text-label-s uppercase text-fg-muted [letter-spacing:var(--tracking-label-tight)]","children":"Where it started"}],["$","$L13",null,{"src":"/brand/logo-kainos.png","alt":"Kainos MX","width":500,"height":300,"sizes":"(max-width: 768px) 80vw, 340px","className":"w-full max-w-[240px] opacity-80"}]]}]]}],["$","div",null,{"className":"space-y-5 font-mono text-body text-fg-secondary","children":[["$","p",null,{"children":"We began as Kainos MX, a small studio shipping websites for whoever needed one. Every project taught us something new — so we said yes to harder problems, then harder ones again."}],["$","p",null,{"children":["Websites became platforms. Platforms became the systems that run entire companies — for startups and SMBs and transnationals alike. The lesson stuck:"," ","$L14"]}],"$L15"]}]]}],"$L16","$L17"]}],"$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20"]}]
