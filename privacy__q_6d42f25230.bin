5:["$","main",null,{"className":"mx-auto max-w-[760px] px-6 pt-36 pb-24","children":[["$","p",null,{"className":"font-mono text-label uppercase text-fg-muted [letter-spacing:var(--tracking-label)]","children":"Legal"}],["$","h1",null,{"className":"mt-6 font-display text-display-l font-extrabold text-fg [text-wrap:balance]","children":"Privacy Policy"}],["$","p",null,{"className":"mt-4 font-mono text-body-sm text-fg-muted","children":"Last updated: June 2026"}],["$","div",null,{"className":"mt-8 rounded-xl border-hairline-strong bg-accent/[0.04] p-5 font-mono text-body-sm text-fg-secondary","children":"Draft pending legal review. Responsable details are filled; ensure the legal@weevolveit.com inbox is active and have counsel confirm before going live."}],["$","div",null,{"className":"mt-12 flex flex-col gap-10","children":[["$","section","Data controller (Responsable)",{"children":[["$","h2",null,{"className":"font-display text-display-s font-bold text-fg","children":"Data controller (Responsable)"}],["$","p",null,{"className":"mt-3 font-mono text-body text-fg-secondary","children":"The party responsible for processing your personal data is Carlos Trujillo Puente, operating as WeEvolveIT (persona física con actividad empresarial), RFC TUPC9311273P1, with registered address at Av. Plan de Ayala 1208, Int. 204, Col. Chapultepec, C.P. 62450, Cuernavaca, Morelos, México. For any privacy matter you can reach us at legal@weevolveit.com or through our contact page. This notice is issued under Mexico's Federal Law on Protection of Personal Data Held by Private Parties (LFPDPPP)."}]]}],["$","section","Information we collect",{"children":[["$","h2",null,{"className":"font-display text-display-s font-bold text-fg","children":"Information we collect"}],["$","p",null,{"className":"mt-3 font-mono text-body text-fg-secondary","children":"We collect the data you provide when you contact us or use our tools — such as your name, email, phone/WhatsApp number, company, website URL, and the message or website you submit to our free AI-Visibility and SEO checks. We also collect standard technical data automatically: IP address, device and browser type, pages viewed, and usage analytics."}]]}],["$","section","How we use your information (purposes)",{"children":[["$","h2",null,{"className":"font-display text-display-s font-bold text-fg","children":"How we use your information (purposes)"}],["$","p",null,{"className":"mt-3 font-mono text-body text-fg-secondary","children":"Primary purposes: to respond to your enquiries, deliver the report or action plan you request, provide and improve our services and tools, and fulfil legal and security obligations. Secondary purposes (which you may opt out of at any time): sending you relevant updates, content, and commercial communications. Opting out of secondary purposes does not affect the services you requested."}]]}],["$","section","Cookies & analytics",{"children":[["$","h2",null,{"className":"font-display text-display-s font-bold text-fg","children":"Cookies & analytics"}],["$","p",null,{"className":"mt-3 font-mono text-body text-fg-secondary","children":"With your consent, we use cookies and third-party analytics and marketing tools — including Google Analytics 4, Search Console, Tag Manager, the Meta and TikTok advertising pixels, and Microsoft Clarity (which records anonymized session activity such as clicks, scrolls, and mouse movement) — to understand how the site is used, measure our marketing, and improve your experience. The Meta and TikTok pixels and Microsoft Clarity load only after you accept via the cookie banner. Google Analytics 4 loads on every visit under Google Consent Mode: until you accept, it sets no cookies and collects no identifiers, sending only anonymous, aggregated signals; accepting enables full measurement. You can change your decision at any time from the \"Cookies\" link in the footer, and you can also disable or delete cookies through your browser settings. Some features may not work as intended without them."}]]}],"$L10","$L11","$L12","$L13","$L14"]}]]}]
