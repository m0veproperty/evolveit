10:T999,{"@context":"https://schema.org","@graph":[{"@id":"https://weevolveit.com#organization","@type":"Organization","name":"WeEvolveIT","alternateName":["We Evolve IT","We EvolveIT","WeEvolve IT","We Evolve","Evolve IT"],"url":"https://weevolveit.com","logo":"https://weevolveit.com/brand/logo-weevolveit-dark.svg","sameAs":["https://www.linkedin.com/company/weevolveit","https://www.instagram.com/weevolveit","https://www.facebook.com/weevolveit","https://www.tiktok.com/@weevolveit"],"foundingDate":"2010","founders":[],"address":{"@type":"PostalAddress","streetAddress":"Venustiano Carranza 601","addressLocality":"Monterrey","addressRegion":"Nuevo León","postalCode":"64710","addressCountry":"MX"},"areaServed":[{"@type":"Country","name":"Mexico"},{"@type":"Country","name":"United States"},{"@type":"Country","name":"United Arab Emirates"}]},{"@type":"WebSite","@id":"https://weevolveit.com#website","url":"https://weevolveit.com","name":"WeEvolveIT","publisher":{"@id":"https://weevolveit.com#organization"}},{"@type":"ProfessionalService","@id":"https://weevolveit.com#local-business","name":"WeEvolveIT","description":"AI specialists. A five-phase method — Discover, Diagnose, Design, Deliver, Evolve — that transforms how your business runs on technology. HQ Monterrey, presence in Dubai, 17 countries served.","url":"https://weevolveit.com","logo":"https://weevolveit.com/brand/logo-weevolveit-dark.svg","image":"https://weevolveit.com/opengraph-image.jpg","address":{"@type":"PostalAddress","streetAddress":"Venustiano Carranza 601","addressLocality":"Monterrey","addressRegion":"Nuevo León","postalCode":"64710","addressCountry":"MX"},"areaServed":[{"@type":"Country","name":"Mexico"},{"@type":"Country","name":"United States"},{"@type":"Country","name":"United Arab Emirates"}],"sameAs":["https://www.linkedin.com/company/weevolveit","https://www.instagram.com/weevolveit","https://www.facebook.com/weevolveit","https://www.tiktok.com/@weevolveit"],"foundingDate":"2010","priceRange":"$$","knowsLanguage":["es-MX","en-US"],"slogan":"your tech partner. evolved.","contactPoint":{"@type":"ContactPoint","contactType":"sales","url":"https://wa.me/19562721609?text=Hola%20WeEvolveIT%20%F0%9F%91%8B%20vi%20su%20sitio%20y%20me%20interesa%20su%20servicio%2C%20me%20gustar%C3%ADa%20platicar%20de%20mi%20proyecto.","availableLanguage":["Spanish","English"],"areaServed":["MX","US"]},"parentOrganization":{"@id":"https://weevolveit.com#organization"}}]}4:["$","html",null,{"lang":"en","className":"geist_mono_1bf8cbf6-module__FlyLvG__variable jetbrains_mono_84d6efd-module__5Hl15a__variable h-full antialiased","suppressHydrationWarning":true,"children":[["$","head",null,{"children":[["$","link",null,{"rel":"preconnect","href":"https://www.googletagmanager.com","crossOrigin":"anonymous"}],["$","link",null,{"rel":"preconnect","href":"https://ipapi.co","crossOrigin":"anonymous"}],["$","link",null,{"rel":"dns-prefetch","href":"https://www.googletagmanager.com"}],["$","link",null,{"rel":"dns-prefetch","href":"https://ipapi.co"}],["$","script",null,{"dangerouslySetInnerHTML":{"__html":"try {\n  if ('scrollRestoration' in history) history.scrollRestoration = 'manual';\n  window.scrollTo(0, 0);\n  var seenIntro = false;\n  try { seenIntro = !!sessionStorage.getItem('we_intro_seen'); } catch (e) {}\n  if (seenIntro || window.matchMedia('(prefers-reduced-motion: reduce)').matches || window.matchMedia('(max-width: 767px)').matches) {\n    document.documentElement.classList.add('intro-skip');\n  }\n} catch (e) {}"}}]]}],["$","body",null,{"className":"isolate min-h-full flex flex-col overflow-x-clip bg-bg text-fg font-mono","suppressHydrationWarning":true,"children":[["$","script",null,{"id":"site-schema","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],"$L11"]}]]}]
12:T1954,{"@context":"https://schema.org","@graph":[{"@type":"WebSite","@id":"https://weevolveit.com#website","url":"https://weevolveit.com","name":"WeEvolveIT","publisher":{"@id":"https://weevolveit.com#organization"}},{"@id":"https://weevolveit.com#organization","@type":"Organization","name":"WeEvolveIT","alternateName":["We Evolve IT","We EvolveIT","WeEvolve IT","We Evolve","Evolve IT"],"url":"https://weevolveit.com","logo":"https://weevolveit.com/brand/logo-weevolveit-dark.svg","sameAs":["https://www.linkedin.com/company/weevolveit","https://www.instagram.com/weevolveit","https://www.facebook.com/weevolveit","https://www.tiktok.com/@weevolveit"],"foundingDate":"2010","founders":[],"address":{"@type":"PostalAddress","streetAddress":"Venustiano Carranza 601","addressLocality":"Monterrey","addressRegion":"Nuevo León","postalCode":"64710","addressCountry":"MX"},"areaServed":[{"@type":"Country","name":"Mexico"},{"@type":"Country","name":"United States"},{"@type":"Country","name":"United Arab Emirates"}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://weevolveit.com/"},{"@type":"ListItem","position":2,"name":"Services","item":"https://weevolveit.com/services"},{"@type":"ListItem","position":3,"name":"Paid Media","item":"https://weevolveit.com/services/paid-media"}]},{"@type":"Service","@id":"https://weevolveit.com/services/paid-media#service","name":"Paid Media","description":"Paid media (PPC — pay-per-click, also called paid search or SEM) is advertising you pay for to appear instantly at the top of search and social — Google Ads, Meta/Facebook, and more. You bid to reach people actively searching or matching your audience, and pay per click or impression. Done right, it's the fastest way to buy qualified traffic and measurable ROI; done wrong, it quietly burns budget.","serviceType":"PPC & Paid Media Management","provider":{"@id":"https://weevolveit.com#organization"},"url":"https://weevolveit.com/services/paid-media","areaServed":[{"@type":"Country","name":"Mexico"},{"@type":"Country","name":"United States"},{"@type":"Country","name":"United Arab Emirates"}],"offers":{"@type":"Offer","priceCurrency":"USD","availability":"https://schema.org/InStock","url":"https://weevolveit.com/services/paid-media#contact"}},{"@type":"HowTo","name":"How we run a paid media engagement","step":[{"@type":"HowToStep","position":1,"name":"Discover","text":"We research your market, competitors, keywords, and audiences — and the numbers that make paid profitable. A fixed-scope audit with a costed plan."},{"@type":"HowToStep","position":2,"name":"Diagnose","text":"We assess your account, tracking, landing pages, and wasted spend — and find the fastest wins."},{"@type":"HowToStep","position":3,"name":"Design","text":"We design the campaign structure, bidding strategy, audiences, creative, and landing pages."},{"@type":"HowToStep","position":4,"name":"Deliver","text":"We launch, manage, and optimize — bids, keywords, creative, and budget — reporting transparently."},{"@type":"HowToStep","position":5,"name":"Evolve","text":"Continuous optimization. We keep cutting wasted spend, testing creative, and scaling what works — so your ROAS keeps improving over time."}]},{"@type":"CollectionPage","@id":"https://weevolveit.com/services/paid-media#page","url":"https://weevolveit.com/services/paid-media","name":"Paid Media | WeEvolveIT","description":"Paid media (PPC — pay-per-click, also called paid search or SEM) is advertising you pay for to appear instantly at the top of search and social — Google Ads, Meta/Facebook, and more. You bid to reach people actively searching or matching your audience, and pay per click or impression. Done right, it's the fastest way to buy qualified traffic and measurable ROI; done wrong, it quietly burns budget.","isPartOf":{"@id":"https://weevolveit.com#website"},"about":{"@type":"Service","name":"Paid Media"}},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is paid media (PPC), and what does a PPC agency do?","acceptedAnswer":{"@type":"Answer","text":"Paid media (PPC, pay-per-click) is advertising on Google, Meta/Facebook, and other platforms where you pay to appear at the top of search or in social feeds. A PPC agency or company plans, builds, and manages those campaigns — paid search, social, and SEM — including keyword and audience research, bidding, creative, landing pages, and tracking — to turn ad spend into measurable revenue."}},{"@type":"Question","name":"PPC or SEO — which should I invest in?","acceptedAnswer":{"@type":"Answer","text":"PPC is the fastest way to get to the top — you appear today, but traffic stops when the budget does. SEO is slower but compounds and keeps working without per-click cost. Most businesses do both: ads to capture demand now, SEO building owned visibility underneath. We run both, full-funnel."}},{"@type":"Question","name":"How much does PPC management cost?","acceptedAnswer":{"@type":"Answer","text":"It depends on platforms, spend, and scope. Our PPC services — Google Ads management, paid search, and Meta — are billed as a transparent flat management fee, not a percentage of your ad spend (which rewards an agency for making you spend more). You pay the ad platforms directly, so you always control and see your budget. We scope it up front, no surprises."}},{"@type":"Question","name":"Google Ads or Facebook/Meta Ads — which is right for me?","acceptedAnswer":{"@type":"Answer","text":"Google Ads captures high-intent demand — people already searching for what you offer. Meta (Facebook/Instagram) finds buyers by audience before they search, great for awareness and retargeting. The right mix depends on your goals and margins; most businesses benefit from both, and we'll tell you where your money works hardest."}},{"@type":"Question","name":"Do I own my ad account?","acceptedAnswer":{"@type":"Answer","text":"Yes — always. Many agencies hold your Google Ads or Meta account hostage so you can't leave. With us, the accounts, data, and history are yours from day one. Full transparency, no lock-in."}},{"@type":"Question","name":"How do you measure ROI?","acceptedAnswer":{"@type":"Answer","text":"We set up proper conversion tracking and GA4 so every dollar ties to a real outcome — leads or sales, not just clicks. We report on ROAS (return on ad spend) and cost-per-acquisition, and optimize toward profit, not vanity metrics."}}]}]}5:["$","main",null,{"className":"mx-auto max-w-[1400px] px-6","children":[["$","script",null,{"id":"paid-media-schema","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$12"}}],"$L13","$L14","$L15",["$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20"],"$L21","$L22","$L23","$L24"]}]
