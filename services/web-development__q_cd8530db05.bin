24:["$","section",null,{"id":"web-app-dev","data-reveal":true,"className":"scroll-mt-24 border-b-hairline-soft py-20","children":["$undefined",["$","h2",null,{"className":"max-w-[30ch] font-display text-display-l font-extrabold text-fg [text-wrap:balance]","children":"Custom web application development, not just websites"}],["$","p",null,{"className":"mt-8 max-w-[70ch] font-mono text-body text-fg-secondary","children":"When a brochure site isn't enough, our custom web application development turns your idea into working software: client portals, dashboards, booking systems, internal tools, SaaS products, and progressive web apps (PWAs). We build the full stack, React or Next.js on the front end, Node and a real database with secure APIs on the back end, and we connect it to the systems you already run. It's custom web app development you own end to end, with the same speed, SEO, and Core Web Vitals discipline we bring to every site."}],"$undefined","$undefined"]}]
