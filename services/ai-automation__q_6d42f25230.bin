16:["$","section",null,{"id":"what-is","data-reveal":true,"className":"scroll-mt-24 border-b-hairline-soft py-20","children":[["$","div",null,{"className":"grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16","children":[["$","div",null,{"children":[["$","h2",null,{"className":"max-w-[22ch] font-display text-display-l font-extrabold text-fg [text-wrap:balance]","children":"What is AI automation?"}],["$","p",null,{"className":"mt-8 font-mono text-body text-fg-secondary","children":"AI automation uses AI to run your business processes end to end — not just rule-based scripts. Where traditional automation follows fixed rules and breaks on the first exception, AI automation reads documents, makes decisions, and handles the messy middle. We map your workflows, wire your tools, and add AI where rules fall short — so the work runs itself."}]]}],["$","figure",null,{"className":"relative aspect-[4/3] overflow-hidden rounded-2xl border-hairline","children":["$","$L31",null,{"src":"/images/services/ai-automation/what-is.webp","alt":"AI automation running a business process across connected tools, with AI handling the exceptions","fill":true,"sizes":"(max-width:1024px) 100vw, 50vw","className":"object-cover"}]}]]}],["$","dl",null,{"className":"mt-12 grid grid-cols-1 gap-4 md:grid-cols-2","children":[["$","div","AI automation vs traditional automation (RPA)?",{"className":"rounded-xl border-hairline bg-white/[0.015] p-6","children":[["$","dt",null,{"className":"font-display text-display-s font-bold text-fg","children":"AI automation vs traditional automation (RPA)?"}],["$","dd",null,{"className":"mt-3 font-mono text-body text-fg-secondary","children":"Traditional automation and RPA follow fixed, hard-coded rules — fast, but they break the moment a document, email, or case is off-script. AI automation adds reasoning: it reads unstructured inputs, decides, and handles exceptions, so the process keeps running instead of landing back in a person's lap."}]]}],["$","div","AI vs automation — what's the difference?",{"className":"rounded-xl border-hairline bg-white/[0.015] p-6","children":[["$","dt",null,{"className":"font-display text-display-s font-bold text-fg","children":"AI vs automation — what's the difference?"}],["$","dd",null,{"className":"mt-3 font-mono text-body text-fg-secondary","children":"Automation executes a defined process. AI makes the judgment calls inside it — classifying, extracting, deciding. AI automation is the two together: the reliability of automation plus the flexibility of AI, so you can automate work that used to need a person."}]]}]]}]]}]
