{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/((?!_next|__sitecloner|brand|data|images|logos|icon.png|apple-icon.png|favicon.ico|opengraph-image).*)",
      "destination": "/index.html"
    }
  ]
}
