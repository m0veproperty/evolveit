16:["$","section",null,{"id":"what-is","data-reveal":true,"className":"scroll-mt-24 border-b-hairline-soft py-20","children":[["$","div",null,{"className":"grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16","children":[["$","div",null,{"children":[["$","h2",null,{"className":"max-w-[22ch] font-display text-display-l font-extrabold text-fg [text-wrap:balance]","children":"What is Industrial IoT?"}],["$","p",null,{"className":"mt-8 font-mono text-body text-fg-secondary","children":"Industrial IoT (IIoT) is connecting your machines, sensors, and production lines to software that turns their signals into decisions — connectivity and edge, an IoT platform and dashboards, and AI that predicts failures before they happen. It's the software and integration layer, not the hardware: we connect what you already run, on your cloud, and you own the platform."}]]}],["$","figure",null,{"className":"relative aspect-[4/3] overflow-hidden rounded-2xl border-hairline","children":["$","$L32",null,{"src":"/images/services/industrial-iot/what-is.webp","alt":"The industrial IoT maturity ladder: machines and sensors connect through an edge gateway into an IoT platform and dashboard, up to a predictive-maintenance alert","fill":true,"sizes":"(max-width:1024px) 100vw, 50vw","className":"object-cover"}]}]]}],["$","dl",null,{"className":"mt-12 grid grid-cols-1 gap-4 md:grid-cols-2","children":[["$","div","IIoT vs IoT — what's the difference?",{"className":"rounded-xl border-hairline bg-white/[0.015] p-6","children":[["$","dt",null,{"className":"font-display text-display-s font-bold text-fg","children":"IIoT vs IoT — what's the difference?"}],["$","dd",null,{"className":"mt-3 font-mono text-body text-fg-secondary","children":"Consumer IoT is smart homes and wearables. Industrial IoT — the industrial internet of things, or IIoT — connects factories, machines, and infrastructure, where uptime, safety, and integration with OT systems (PLCs, SCADA, MES) matter. Higher stakes, harder integration, bigger ROI — which is exactly what we do."}]]}],["$","div","Do I own my IoT platform and data?",{"className":"rounded-xl border-hairline bg-white/[0.015] p-6","children":[["$","dt",null,{"className":"font-display text-display-s font-bold text-fg","children":"Do I own my IoT platform and data?"}],["$","dd",null,{"className":"mt-3 font-mono text-body text-fg-secondary","children":"Yes — always. Your platform, dashboards, code, and data are yours, built on your cloud. Vendor-neutral and no lock-in to a black-box IIoT platform; connect any sensor, PLC, or cloud, and take it anywhere."}]]}]]}]]}]
